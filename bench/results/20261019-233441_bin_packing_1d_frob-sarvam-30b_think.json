 "best_diff": "--- initial\n+++ best\n@@ -19,17 +19,84 @@\n     (time.process_time(); more than 1.5 x the limit makes the program invalid).\n     Only the Python standard library may be used.\n \n-    Current method: next fit (open a new bin whenever the next item does not fit).\n+    Method: best\u2011fit decreasing with simple local search.\n     \"\"\"\n+    # constants for time control\n+    TIME_LIMIT = 1.5\n+    MAX_ITER = 1000\n+\n+    # sort items by decreasing size, keep original indices\n+    sorted_items = sorted(enumerate(sizes), key=lambda x: -x[1])\n+\n+    # bins holds (load, list_of_original_indices)\n     bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n-    return bins\n+\n+    # pack items using best\u2011fit\n+    for i, s in sorted_items:\n+        # time check\n+        if time.process_time() > TIME_LIMIT:\n+            break\n+        # find bin with minimal remaining capacity that can fit the item\n+        best_bin_idx = None\n+        best_remaining = None\n+        for idx_bin, (load, items) in enumerate(bins):\n+            if load + s <= capacity:\n+                remaining = capacity - (load + s)\n+                if best_bin_idx is None or remaining < best_remaining:\n+                    best_bin_idx = idx_bin\n+                    best_remaining = remaining\n+        if best_bin_idx is not None:\n+            load, items = bins[best_bin_idx]\n+            items.append(i)\n+            bins[best_bin_idx] = (load + s, items)\n+        else:\n+            # open a new bin\n+            bins.append((s, [i]))\n+\n+    # simple local search: move items from lightly filled bins to heavier bins\n+    for _ in range(MAX_ITER):\n+        if time.process_time() > TIME_LIMIT:\n+            break\n+        # find a bin with load < capacity/2\n+        cand_bin_idx = None\n+        for idx_bin, (load, _) in enumerate(bins):\n+            if load < capacity / 2:\n+                cand_bin_idx = idx_bin\n+                break\n+        if cand_bin_idx is None:\n+            break\n+        # sort items in that bin by size descending to try larger items first\n+        items_to_move = sorted(bins[cand_bin_idx][1], key=lambda x: -sizes[x])\n+        moved_any = False\n+        for item_idx in items_to_move:\n+            s = sizes[item_idx]\n+            # find a bin where the item fits, preferring minimal remaining space\n+            target_bin_idx = None\n+            min_remaining = None\n+            for idx_bin, (load, _) in enumerate(bins):\n+                if idx_bin == cand_bin_idx:\n+                    continue\n+                if load + s <= capacity:\n+                    remaining = capacity - (load + s)\n+                    if target_bin_idx is None or remaining < min_remaining:\n+                        target_bin_idx = idx_bin\n+                        min_remaining = remaining\n+            if target_bin_idx is not None:\n+                # move item\n+                bins[cand_bin_idx][1].remove(item_idx)\n+                load_target, items_target = bins[target_bin_idx]\n+                items_target.append(item_idx)\n+                bins[target_bin_idx] = (load_target + s, items_target)\n+                moved_any = True\n+        if not moved_any:\n+            continue\n+        # after moving, if any bin becomes empty we could remove it, but we\n+        # stop after one pass to keep runtime low\n+        break\n+\n+    # build the final list of bins\n+    final_bins = []\n+    for _, items in bins:\n+        final_bins.append(items)\n+    return final_bins\n # OMEGA-BLOCK-END\n",
