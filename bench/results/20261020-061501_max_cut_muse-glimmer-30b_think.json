 "best_diff": "--- initial\n+++ best\n@@ -21,5 +21,97 @@\n \n     Current method: alternate the sides by node index (ignores the edges entirely).\n     \"\"\"\n-    return [i % 2 for i in range(n)]\n+    start = time.process_time()\n+    time_limit = 2.0\n+\n+    adj = [[] for _ in range(n)]\n+    total_inc = [0] * n\n+    for u, v, w in edges:\n+        adj[u].append((v, w))\n+        adj[v].append((u, w))\n+        total_inc[u] += w\n+        total_inc[v] += w\n+\n+    def compute_cut(sides):\n+        c = 0\n+        for u in range(n):\n+            su = sides[u]\n+            for v, w in adj[u]:\n+                if v > u and sides[v] != su:\n+                    c += w\n+        return c\n+\n+    def init_greedy(order):\n+        sides = [None] * n\n+        sides[order[0]] = 0\n+        for v in order[1:]:\n+            sum0 = 0\n+            sum1 = 0\n+            for nb, w in adj[v]:\n+                if sides[nb] is not None:\n+                    if sides[nb] == 0:\n+                        sum0 += w\n+                    else:\n+                        sum1 += w\n+            sides[v] = 0 if sum0 <= sum1 else 1\n+        return sides\n+\n+    def local_search(sides):\n+        sides = sides[:]\n+        gains = [0] * n\n+        for v in range(n):\n+            sv = sides[v]\n+            s = 0\n+            for nb, w in adj[v]:\n+                if sides[nb] == sv:\n+                    s += w\n+            gains[v] = 2 * s - total_inc[v]\n+        while True:\n+            if time.process_time() - start > time_limit * 0.95:\n+                break\n+            best_gain = 0\n+            best_v = -1\n+            for v in range(n):\n+                g = gains[v]\n+                if g > best_gain:\n+                    best_gain = g\n+                    best_v = v\n+            if best_v == -1:\n+                break\n+            sides[best_v] ^= 1\n+            sv = sides[best_v]\n+            s = 0\n+            for nb, w in adj[best_v]:\n+                if sides[nb] == sv:\n+                    s += w\n+            gains[best_v] = 2 * s - total_inc[best_v]\n+            for nb, _ in adj[best_v]:\n+                u = nb\n+                su = sides[u]\n+                s = 0\n+                for nnb, ww in adj[u]:\n+                    if sides[nnb] == su:\n+                        s += ww\n+                gains[u] = 2 * s - total_inc[u]\n+        return sides\n+\n+    best_side = None\n+    best_cut = -1\n+\n+    order = list(range(n))\n+    sides = init_greedy(order)\n+    sides = local_search(sides)\n+    best_cut = compute_cut(sides)\n+    best_side = sides[:]\n+\n+    while time.process_time() - start < time_limit * 0.9:\n+        order = list(range(n))\n+        random.shuffle(order)\n+        sides = init_greedy(order)\n+        sides = local_search(sides)\n+        c = compute_cut(sides)\n+        if c > best_cut:\n+            best_cut = c\n+            best_side = sides[:]\n+    return best_side\n # OMEGA-BLOCK-END\n",
