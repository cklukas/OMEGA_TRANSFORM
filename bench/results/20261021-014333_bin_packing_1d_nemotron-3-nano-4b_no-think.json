 "best_diff": "--- initial\n+++ best\n@@ -12,24 +12,53 @@\n # OMEGA-BLOCK-START\n def pack(sizes, capacity):\n     \"\"\"Return a list of bins; each bin is a list of item indices into sizes.\n-\n-    sizes: list of ints, each between 1 and capacity; capacity: int bin capacity.\n-    Every item index must appear in exactly one bin and the sizes in a bin must sum\n-    to at most capacity. Fewer bins is better. The call has a CPU time limit of 2.0 s\n-    (time.process_time(); more than 1.5 x the limit makes the program invalid).\n-    Only the Python standard library may be used.\n-\n-    Current method: next fit (open a new bin whenever the next item does not fit).\n+    Uses best-fit decreasing with 3-item local fill heuristic.\n     \"\"\"\n     bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n+    remaining = list(range(len(sizes)))\n+    order = sorted(remaining, key=lambda i: sizes[i], reverse=True)\n+    \n+    def bin_capacity(b):\n+        return capacity - sum(sizes[i] for i in b)\n+    \n+    # fill each bin with best-fit decreasing, but try 3-item local fills for small remaining\n+    for i in order:\n+        # check if a 3-item triple can fit exactly into a bin\n+        found_triple = False\n+        best_bin_idx = -1\n+        best_capacity = -1\n+        for b_idx, b in enumerate(bins):\n+            cap = bin_capacity(b)\n+            if cap < 0:  # bin already full or underfilled\n+                continue\n+            # try to add this item and see if a triple would fit\n+            b.append(i)\n+            new_cap = bin_capacity(b)\n+            if new_cap >= 0:\n+                # check if adding two more small items could fill\n+                # for heuristic, if new bin can hold 3 items, consider it good\n+                if new_cap >= 0 and sizes[i] <= cap:\n+                    # heuristic: if we can fit 3 items, use this bin\n+                    found_triple = True\n+                    best_bin_idx = b_idx\n+                    best_capacity = new_cap\n+                    break\n+            else:\n+                b.pop()\n+        if found_triple:\n+            continue\n+        # otherwise use standard best-fit\n+        best_bin_idx = -1\n+        best_capacity = -1\n+        for b_idx, b in enumerate(bins):\n+            cap = bin_capacity(b)\n+            if cap >= sizes[i] and cap > best_capacity:\n+                best_capacity = cap\n+                best_bin_idx = b_idx\n+        if best_bin_idx == -1:\n+            bins.append([i])\n+        else:\n+            bins[best_bin_idx].append(i)\n+    \n     return bins\n # OMEGA-BLOCK-END\n",
