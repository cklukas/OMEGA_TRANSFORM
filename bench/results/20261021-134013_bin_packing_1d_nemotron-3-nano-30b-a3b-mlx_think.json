 "best_diff": "--- initial\n+++ best\n@@ -10,26 +10,68 @@\n import time\n \n # OMEGA-BLOCK-START\n+import time\n+\n def pack(sizes, capacity):\n     \"\"\"Return a list of bins; each bin is a list of item indices into sizes.\n-\n+    \n     sizes: list of ints, each between 1 and capacity; capacity: int bin capacity.\n     Every item index must appear in exactly one bin and the sizes in a bin must sum\n     to at most capacity. Fewer bins is better. The call has a CPU time limit of 2.0 s\n     (time.process_time(); more than 1.5 x the limit makes the program invalid).\n     Only the Python standard library may be used.\n-\n-    Current method: next fit (open a new bin whenever the next item does not fit).\n     \"\"\"\n-    bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n+    start = time.process_time()\n+    # keep original indices\n+    items = list(enumerate(sizes))\n+    # sort by size descending\n+    items.sort(key=lambda x: x[1], reverse=True)\n+    bins = []          # list of bins (each a list of original indices)\n+    loads = []         # current load of each bin\n+    \n+    # best\u2011fit decreasing placement\n+    for idx, size in items:\n+        best = None\n+        best_slack = capacity + 1\n+        for b, load in enumerate(loads):\n+            if load + size <= capacity and capacity - (load + size) < best_slack:\n+                best = b\n+                best_slack = capacity - (load + size)\n+        if best is not None:\n+            bins[best].append(idx)\n+            loads[best] += size\n+        else:\n+            bins.append([idx])\n+            loads.append(size)\n+        # time check \u2013 stop if near limit\n+        if time.process_time() - start > 1.9:\n+            # quick local improvement before giving up\n+            while time.process_time() - start < 1.9:\n+                # find sparsest non\u2011empty bin\n+                min_i = min(range(len(loads)), key=lambda i: loads[i])\n+                if loads[min_i] == 0:\n+                    break\n+                # try moving each item from that bin to another bin\n+                for item in bins[min_i][:]:\n+                    sz = sizes[item]\n+                    # find a bin where it fits\n+                    for t in range(len(loads)):\n+                        if t == min_i:\n+                            continue\n+                        if loads[t] + sz <= capacity:\n+                            # move\n+                            bins[min_i].remove(item)\n+                            bins[t].append(item)\n+                            loads[min_i] -= sz\n+                            loads[t] += sz\n+                            if not bins[min_i]:\n+                                bins.pop(min_i)\n+                                loads.pop(min_i)\n+                            break\n+                    if not bins[min_i]:\n+                        break\n+                if not any(bins):\n+                    break\n+            break\n     return bins\n # OMEGA-BLOCK-END\n",
