 "best_diff": "--- initial\n+++ best\n@@ -10,6 +10,12 @@\n import time\n \n # OMEGA-BLOCK-START\n+# OMEGA-DEF\n+import math\n+import random\n+import time\n+\n+# OMEGA-DEF\n def pack(sizes, capacity):\n     \"\"\"Return a list of bins; each bin is a list of item indices into sizes.\n \n@@ -19,17 +25,36 @@\n     (time.process_time(); more than 1.5 x the limit makes the program invalid).\n     Only the Python standard library may be used.\n \n-    Current method: next fit (open a new bin whenever the next item does not fit).\n+    Current method: best-fit decreasing (BFD) with sorted descending items.\n+     The bins are constructed greedily to maximize fill per bin, minimizing total bins.\n     \"\"\"\n-    bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n+    # constant bin capacity\n+    BIN_CAPACITY = capacity\n+    # sort items by size descending to enable BFD\n+    sorted_indices = sorted(range(len(sizes)), key=lambda i: sizes[i], reverse=True)\n+    bins = [[]]\n+    current_load = 0\n+\n+    for idx in sorted_indices:\n+        # find the bin with the most space left that can still hold this item\n+        best_bin = None\n+        best_capacity = 0\n+        for bin_idx, bin_items in enumerate(bins):\n+            bin_capacity = BIN_CAPACITY - sum(sizes[i] for i in bin_items)\n+            if bin_capacity >= sizes[idx] and bin_capacity > best_capacity:\n+                best_bin = bin_idx\n+                best_capacity = bin_capacity\n+\n+        if best_bin is None:\n+            bins.append([idx])\n+            current_load = sizes[idx]\n+        else:\n+            bins[best_bin].append(idx)\n+            current_load = 0  # just tracking; not used for decision\n+\n+    if len(bins[-1]) == 0:\n+        bins.pop()\n+\n     return bins\n+# OMEGA-DEF\n # OMEGA-BLOCK-END\n",
