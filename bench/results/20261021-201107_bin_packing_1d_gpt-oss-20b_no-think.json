 "best_diff": "--- initial\n+++ best\n@@ -13,23 +13,91 @@\n def pack(sizes, capacity):\n     \"\"\"Return a list of bins; each bin is a list of item indices into sizes.\n \n-    sizes: list of ints, each between 1 and capacity; capacity: int bin capacity.\n-    Every item index must appear in exactly one bin and the sizes in a bin must sum\n-    to at most capacity. Fewer bins is better. The call has a CPU time limit of 2.0 s\n-    (time.process_time(); more than 1.5 x the limit makes the program invalid).\n-    Only the Python standard library may be used.\n+    BFD heuristic with optional merge and random 1-1 swap improvements.\n+    \"\"\"\n+    # constants for optional phases\n+    MERGE_ENABLED = 1  # 1 to perform merge pass\n+    MAX_SWAPS = 20000\n+    SWAP_TIME_LIMIT = 1.5\n \n-    Current method: next fit (open a new bin whenever the next item does not fit).\n-    \"\"\"\n+    n = len(sizes)\n+    order = sorted(range(n), key=lambda i: -sizes[i])\n+\n     bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n+    loads = []\n+\n+    for idx in order:\n+        s = sizes[idx]\n+        best_bin = None\n+        best_load = -1\n+        for b, load in enumerate(loads):\n+            if load + s <= capacity and load > best_load:\n+                best_load = load\n+                best_bin = b\n+        if best_bin is not None:\n+            bins[best_bin].append(idx)\n+            loads[best_bin] += s\n+        else:\n+            bins.append([idx])\n+            loads.append(s)\n+\n+    # optional merge pass\n+    if MERGE_ENABLED:\n+        i = 0\n+        while i < len(bins):\n+            j = i + 1\n+            merged = False\n+            while j < len(bins):\n+                if loads[i] + loads[j] <= capacity:\n+                    bins[i].extend(bins[j])\n+                    loads[i] += loads[j]\n+                    del bins[j]\n+                    del loads[j]\n+                    merged = True\n+                    break\n+                j += 1\n+            if not merged:\n+                i += 1\n+\n+    # random 1-1 swap local search\n+    if MAX_SWAPS > 0:\n+        start = time.process_time()\n+        attempts = 0\n+        while attempts < MAX_SWAPS and time.process_time() - start < SWAP_TIME_LIMIT:\n+            attempts += 1\n+            if len(bins) < 2:\n+                break\n+            a, b = random.sample(range(len(bins)), 2)\n+            if not bins[a] or not bins[b]:\n+                continue\n+            i_item = random.choice(bins[a])\n+            j_item = random.choice(bins[b])\n+            s_i = sizes[i_item]\n+            s_j = sizes[j_item]\n+            if loads[a] - s_i + s_j <= capacity and loads[b] - s_j + s_i <= capacity:\n+                bins[a].remove(i_item)\n+                bins[b].remove(j_item)\n+                bins[a].append(j_item)\n+                bins[b].append(i_item)\n+                loads[a] = loads[a] - s_i + s_j\n+                loads[b] = loads[b] - s_j + s_i\n+\n+    # final merge pass to clean up\n+    i = 0\n+    while i < len(bins):\n+        j = i + 1\n+        merged = False\n+        while j < len(bins):\n+            if loads[i] + loads[j] <= capacity:\n+                bins[i].extend(bins[j])\n+                loads[i] += loads[j]\n+                del bins[j]\n+                del loads[j]\n+                merged = True\n+                break\n+            j += 1\n+        if not merged:\n+            i += 1\n+\n     return bins\n # OMEGA-BLOCK-END\n",
