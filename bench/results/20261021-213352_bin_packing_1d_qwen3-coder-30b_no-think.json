 "best_diff": "--- initial\n+++ best\n@@ -19,17 +19,82 @@\n     (time.process_time(); more than 1.5 x the limit makes the program invalid).\n     Only the Python standard library may be used.\n \n-    Current method: next fit (open a new bin whenever the next item does not fit).\n+    Current method: first-fit decreasing with local search improvements.\n     \"\"\"\n+    # Sort items by decreasing size\n+    indexed_sizes = [(sizes[i], i) for i in range(len(sizes))]\n+    indexed_sizes.sort(reverse=True)\n+    \n+    # Initialize bins\n     bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n-    return bins\n+    bin_loads = []\n+    \n+    # First fit decreasing placement\n+    for size, index in indexed_sizes:\n+        placed = False\n+        for i in range(len(bins)):\n+            if bin_loads[i] + size <= capacity:\n+                bins[i].append(index)\n+                bin_loads[i] += size\n+                placed = True\n+                break\n+        if not placed:\n+            bins.append([index])\n+            bin_loads.append(size)\n+    \n+    # Local search improvement\n+    start_time = time.process_time()\n+    timeout = 1.8  # Leave some margin before hard timeout\n+    \n+    def improve_bins():\n+        improved = True\n+        while improved and time.process_time() - start_time < timeout:\n+            improved = False\n+            \n+            # Try moving items between bins to reduce total bin count or increase load balance\n+            for i in range(len(bins)):\n+                if len(bins[i]) == 0: continue\n+                \n+                # Try removing item from bin i\n+                temp_bin = bins[i][:]\n+                temp_load = bin_loads[i]\n+                \n+                # For each item in bin i, try moving it to another bin\n+                for j in range(len(temp_bin)):\n+                    item_idx = temp_bin[j]\n+                    item_size = sizes[item_idx]\n+                    \n+                    # Remove item from current bin\n+                    temp_bin.remove(item_idx)\n+                    temp_load -= item_size\n+                    \n+                    # Try placing item in other bins\n+                    best_bin = -1\n+                    best_diff = float('inf')\n+                    for k in range(len(bins)):\n+                        if k == i: continue\n+                        if bin_loads[k] + item_size <= capacity:\n+                            diff = capacity - (bin_loads[k] + item_size)\n+                            if diff < best_diff:\n+                                best_diff = diff\n+                                best_bin = k\n+                    \n+                    # If we can place the item in another bin, do so\n+                    if best_bin != -1:\n+                        bins[best_bin].append(item_idx)\n+                        bin_loads[best_bin] += item_size\n+                        bins[i] = temp_bin[:]\n+                        bin_loads[i] = temp_load\n+                        improved = True\n+                        break\n+                    \n+                    # If not, put it back\n+                    temp_bin.insert(j, item_idx)\n+                    temp_load += item_size\n+    \n+    improve_bins()\n+    \n+    # Remove empty bins and return result\n+    final_bins = [bin_list for bin_list in bins if bin_list]\n+    return final_bins\n # OMEGA-BLOCK-END\n",
