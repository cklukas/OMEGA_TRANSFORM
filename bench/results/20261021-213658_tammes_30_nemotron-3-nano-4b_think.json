 "best_diff": "--- initial\n+++ best\n@@ -7,20 +7,16 @@\n \n # OMEGA-BLOCK-START\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n+    \"\"\"Return an evenly spaced set of n points on the unit sphere's equator.\n \n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n+    All points lie on the equator (z=0) with azimuth angles 2\u03c0\u00b7k/n, giving a\n+    minimum angular separation of 2\u03c0/n \u2248 3.82\u00b0, which is higher than the random\n+    default.\n     \"\"\"\n-    rng = random.Random(1)\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    for k in range(n):\n+        angle = 2 * math.pi * k / n\n+        points.append((math.cos(angle), math.sin(angle), 0.0))\n     return points\n # OMEGA-BLOCK-END\n \n",
