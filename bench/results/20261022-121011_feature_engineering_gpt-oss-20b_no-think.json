 "best_diff": "--- initial\n+++ best\n@@ -9,6 +9,9 @@\n import math\n \n # OMEGA-BLOCK-START\n+THRESH_X3_INDICATOR = 1.0\n+INV_X3_ENABLED = 1\n+RADIAL_ENABLED = 1\n def features(row):\n     \"\"\"Return the feature vector (a list of at most 30 finite floats) for one row.\n \n@@ -21,5 +24,30 @@\n \n     Current method: the raw inputs.\n     \"\"\"\n-    return list(row)\n+    # Unpack raw inputs\n+    x1, x2, x3, x4, x5, x6 = row\n+    # Log-transform of the skewed feature\n+    log_x3 = math.log(x3)\n+    # Interaction between two normal-like variables\n+    prod_x1x2 = x1 * x2\n+    # Product of interaction with log\n+    prod_x1x2_logx3 = prod_x1x2 * log_x3\n+    # Sign of x4 and x5\n+    sign_x4 = 1 if x4 >= 0 else -1\n+    sign_x5 = 1 if x5 >= 0 else -1\n+    # Squares of raw inputs\n+    sq_x1 = x1 * x1\n+    sq_x2 = x2 * x2\n+    sq_x3 = x3 * x3\n+    sq_x4 = x4 * x4\n+    sq_x5 = x5 * x5\n+    sq_x6 = x6 * x6\n+    # Indicator for x3 > threshold\n+    indicator_x3_gt = 1.0 if x3 > THRESH_X3_INDICATOR else 0.0\n+    # Inverse of x3 if enabled\n+    inv_x3 = 1.0 / x3 if INV_X3_ENABLED and x3 > 1e-9 else 0.0\n+    # Radial distance in normal-like subspace if enabled\n+    radial_norm = math.sqrt(x1*x1 + x2*x2 + x6*x6) if RADIAL_ENABLED else 0.0\n+    # Return raw features plus new transformations\n+    return [x1, x2, x3, x4, x5, x6, log_x3, prod_x1x2, prod_x1x2_logx3, sq_x1, sq_x2, sq_x3, sq_x4, sq_x5, sq_x6, sign_x4, sign_x5, indicator_x3_gt, inv_x3, radial_norm]\n # OMEGA-BLOCK-END\n",
