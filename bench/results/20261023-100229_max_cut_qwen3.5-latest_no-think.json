 "best_diff": "--- initial\n+++ best\n@@ -10,6 +10,10 @@\n import time\n \n # OMEGA-BLOCK-START\n+import math\n+import random\n+import time\n+\n def cut(n, edges):\n     \"\"\"Return a list of n values, side[i] in {0, 1} for node i.\n \n@@ -19,7 +23,128 @@\n     time limit of 2.0 s (time.process_time(); more than 1.5 x the limit makes the program\n     invalid). Only the Python standard library may be used.\n \n-    Current method: alternate the sides by node index (ignores the edges entirely).\n+    Method: Build an adjacency list, then greedily assign each node to the side that\n+    maximizes immediate gain with respect to already-assigned neighbors.\n     \"\"\"\n-    return [i % 2 for i in range(n)]\n+    start_time = time.process_time()\n+    \n+    # Build adjacency list: adj[u] contains (v, w) tuples\n+    adj = [[] for _ in range(n)]\n+    total_weight = 0\n+    for u, v, w in edges:\n+        adj[u].append((v, w))\n+        adj[v].append((u, w))\n+        total_weight += w\n+    \n+    # Assignment array: -1 means unassigned, 0 or 1 means side\n+    assignment = [-1] * n\n+    \n+    # Greedy initialization: place nodes one by one\n+    # To avoid bias from arbitrary order, we start with the node having highest degree\n+    # (most neighbors to consider) and proceed.\n+    degrees = [len(adj[i]) for i in range(n)]\n+    sorted_nodes = sorted(range(n), key=lambda x: -degrees[x])\n+    \n+    for idx in sorted_nodes:\n+        current_side = assignment[idx]\n+        if current_side == -1:  # Unassigned\n+            gain_0 = 0\n+            gain_1 = 0\n+            side_0_neighbors_weight = 0\n+            side_1_neighbors_weight = 0\n+            \n+            for neighbor, weight in adj[idx]:\n+                neighbor_assignment = assignment[neighbor]\n+                if neighbor_assignment != -1:\n+                    side = neighbor_assignment\n+                    other_side = 1 - side\n+                    if side == 0:\n+                        # Neighbor on side 0 contributes to cut if we pick side 1\n+                        gain_0 += weight\n+                    else:\n+                        # Neighbor on side 1 contributes to cut if we pick side 0\n+                        gain_1 += weight\n+            \n+            # Pick the side with higher gain\n+            if gain_0 >= gain_1:\n+                assignment[idx] = 0\n+            else:\n+                assignment[idx] = 1\n+    \n+    # Local search: flip nodes if it improves total cut weight\n+    best_cut = sum(\n+        w for u, v, w in edges\n+        if (assignment[u] != assignment[v])\n+    )\n+    \n+    improved = True\n+    while improved:\n+        improved = False\n+        current_cut = 0\n+        for u, v, w in edges:\n+            if assignment[u] != assignment[v]:\n+                current_cut += w\n+        \n+        # Find node with best positive gain from flipping\n+        max_gain = -1\n+        flip_node = -1\n+        \n+        for i in range(n):\n+            if assignment[i] == -1:\n+                continue\n+            \n+            # Calculate gain of flipping node i\n+            # Gain = (weight to other side) - (weight to own side)\n+            current_side = assignment[i]\n+            other_side = 1 - current_side\n+            \n+            gain_0 = 0\n+            gain_1 = 0\n+            \n+            for neighbor, weight in adj[i]:\n+                neighbor_assignment = assignment[neighbor]\n+                if neighbor_assignment == current_side:\n+                    # If we flip, this edge becomes a cut (gain)\n+                    gain_1 += weight\n+                elif neighbor_assignment != -1 and neighbor_assignment != current_side:\n+                    # Neighbor is on other side; currently cut. If we flip, it stops being cut (loss)\n+                    pass\n+            \n+            weight_to_same = 0\n+            for neighbor, weight in adj[i]:\n+                if assignment[neighbor] == current_side:\n+                    weight_to_same += weight\n+            \n+            # Current contribution is edges to neighbors on different side\n+            cut_contribution = 0\n+            for neighbor, weight in adj[i]:\n+                if assignment[neighbor] != current_side:\n+                    cut_contribution += weight\n+            \n+            # Net gain of flipping this node\n+            net_gain = weight_to_same - cut_contribution\n+            \n+            if net_gain > max_gain:\n+                max_gain = net_gain\n+                flip_node = i\n+        \n+        if max_gain <= 0:\n+            break\n+            \n+        assignment[flip_node] = 1 - assignment[flip_node] # Flip 0<->1\n+        \n+        improved = True\n+    \n+    # Re-calculate best cut to return (and handle time limit)\n+    current_cut = sum(\n+        w for u, v, w in edges\n+        if (assignment[u] != assignment[v])\n+    )\n+    \n+    elapsed = time.process_time() - start_time\n+    if elapsed > 1.5:\n+        # Return best found so far (which is this one since we just finished loop)\n+        pass\n+        \n+    return assignment\n # OMEGA-BLOCK-END\n",
