 "best_diff": "--- initial\n+++ best\n@@ -10,16 +10,100 @@\n import time\n \n # OMEGA-BLOCK-START\n+import time\n+import random\n+\n def cut(n, edges):\n-    \"\"\"Return a list of n values, side[i] in {0, 1} for node i.\n-\n-    n: number of nodes (0..n-1); edges: list of (u, v, w) with 0 <= u < v < n, no\n-    duplicate pairs, integer weight 1 <= w <= 10. The cut weight is the sum of w over\n-    edges whose endpoints are on different sides; larger is better. The call has a CPU\n-    time limit of 2.0 s (time.process_time(); more than 1.5 x the limit makes the program\n-    invalid). Only the Python standard library may be used.\n-\n-    Current method: alternate the sides by node index (ignores the edges entirely).\n-    \"\"\"\n-    return [i % 2 for i in range(n)]\n+    start_time = time.process_time()\n+    deadline = start_time + 1.4  # Leave some margin\n+    \n+    # Build adjacency list\n+    adj = [[] for _ in range(n)]\n+    for u, v, w in edges:\n+        adj[u].append((v, w))\n+        adj[v].append((u, w))\n+    \n+    def compute_cut_weight(assignment):\n+        weight = 0\n+        for u, v, w in edges:\n+            if assignment[u] != assignment[v]:\n+                weight += w\n+        return weight\n+    \n+    def compute_gains(assignment):\n+        gains = [0] * n\n+        for u, v, w in edges:\n+            if assignment[u] == assignment[v]:\n+                gains[u] += w\n+                gains[v] += w\n+            else:\n+                gains[u] -= w\n+                gains[v] -= w\n+        return gains\n+    \n+    def local_search(assignment, gains, cut_weight):\n+        # Best-improvement local search\n+        while time.process_time() < deadline:\n+            best_gain = 0\n+            best_node = -1\n+            for i in range(n):\n+                if gains[i] > best_gain:\n+                    best_gain = gains[i]\n+                    best_node = i\n+            \n+            if best_node == -1 or best_gain <= 0:\n+                break\n+            \n+            # Flip best_node\n+            i = best_node\n+            assignment[i] = 1 - assignment[i]\n+            cut_weight += best_gain\n+            \n+            # Update gains for i and its neighbors\n+            for v, w in adj[i]:\n+                if assignment[v] == assignment[i]:\n+                    gains[v] += 2 * w\n+                else:\n+                    gains[v] -= 2 * w\n+            \n+            gains[i] = -best_gain\n+        \n+        return cut_weight\n+    \n+    # Initial random assignment\n+    best_assignment = None\n+    best_cut = 0\n+    \n+    # Multiple restarts\n+    while time.process_time() < deadline:\n+        # Start from a random assignment\n+        assignment = [random.randint(0, 1) for _ in range(n)]\n+        cut_weight = compute_cut_weight(assignment)\n+        gains = compute_gains(assignment)\n+        \n+        # Local search\n+        cut_weight = local_search(assignment, gains, cut_weight)\n+        \n+        if cut_weight > best_cut:\n+            best_cut = cut_weight\n+            best_assignment = assignment[:]\n+        \n+        # If we have a good solution, try perturbing it\n+        if best_assignment and time.process_time() < deadline:\n+            perturbed = best_assignment[:]\n+            # Flip a random subset of nodes\n+            num_flips = max(1, n // 10)\n+            nodes_to_flip = random.sample(range(n), num_flips)\n+            for i in nodes_to_flip:\n+                perturbed[i] = 1 - perturbed[i]\n+            \n+            cut_weight = compute_cut_weight(perturbed)\n+            gains = compute_gains(perturbed)\n+            cut_weight = local_search(perturbed, gains, cut_weight)\n+            \n+            if cut_weight > best_cut:\n+                best_cut = cut_weight\n+                best_assignment = perturbed[:]\n+    \n+    return best_assignment if best_assignment else [0] * n\n # OMEGA-BLOCK-END\n",
