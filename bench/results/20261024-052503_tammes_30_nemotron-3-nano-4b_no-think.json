 "best_diff": "--- initial\n+++ best\n@@ -7,21 +7,31 @@\n \n # OMEGA-BLOCK-START\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n-\n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n-    \"\"\"\n-    rng = random.Random(1)\n-    points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n-    return points\n+     \"\"\"Return a list of n points (x, y, z) on the unit sphere. \n+     6 poles + Fibonacci z-values in equatorial band + small random rotation. \n+     Ensures low clustering and high min-angle.\"\"\" \n+     fib = [0, 1]\n+     for i in range(2, 15):\n+         fib.append(fib[-1] + fib[-2])\n+     poles = [1, 1/2, 0, -1/2, -1, -1/2]\n+     points = []\n+     for i in range(n):\n+         if i < len(poles):\n+             z = poles[i]\n+             alpha = 0\n+         else:\n+             f = fib[(i % len(fib))]\n+             z = 0.6 * math.sin(math.pi * f / fib[-1])\n+             alpha = 0.2 * math.pi * (f / fib[-1]) * (1 + random.random() * 0.5)\n+         s = math.sqrt(1 - z*z)\n+         theta = 0.5 * 2 * math.pi * (i + random.random() * 10)\n+         jitter_theta = 0.1 * 2 * math.pi * (i % 4) * random.random()\n+         theta += jitter_theta\n+         x = s * math.cos(theta)\n+         y = s * math.sin(theta)\n+         z = max(-1.0, min(1.0, z))\n+         points.append((x, y, z))\n+     return points\n # OMEGA-BLOCK-END\n \n \n",
