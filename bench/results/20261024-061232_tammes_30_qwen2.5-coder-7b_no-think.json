 "best_diff": "--- initial\n+++ best\n@@ -6,21 +6,48 @@\n import random\n \n # OMEGA-BLOCK-START\n+PHI = (1 + math.sqrt(5)) / 2  # Golden ratio\n+S = 2.19  # Repulsion exponent\n+\n+def fibonacci_spiral(n):\n+    \"\"\"Generate n points on a Fibonacci (golden-spiral) sphere.\"\"\"\n+    points = []\n+    for i in range(n):\n+        theta = 2 * math.pi * i / n\n+        z = 1 - 2 * i / (n - 1)\n+        r = math.sqrt(1 - z * z)\n+        x = r * math.cos(theta)\n+        y = r * math.sin(theta)\n+        points.append((x, y, z))\n+    return points\n+\n+def repulsion_force(p1, p2):\n+    \"\"\"Calculate the repulsion force between two points.\"\"\"\n+    dx, dy, dz = p1[0] - p2[0], p1[1] - p2[1], p1[2] - p2[2]\n+    d = math.sqrt(dx * dx + dy * dy + dz * dz)\n+    if d > 0:\n+        return (dx / d, dy / d, dz / d)\n+    else:\n+        return (0, 0, 0)\n+\n+def optimize_points(points, n, max_iterations=1000, step_size=0.1):\n+    \"\"\"Optimize points using a repulsion force.\"\"\"\n+    for _ in range(max_iterations):\n+        new_points = []\n+        for i in range(n):\n+            grad = (0, 0, 0)\n+            for j in range(n):\n+                if i != j:\n+                    force = repulsion_force(points[i], points[j])\n+                    grad = (grad[0] + force[0], grad[1] + force[1], grad[2] + force[2])\n+            new_points.append((points[i][0] - step_size * grad[0], points[i][1] - step_size * grad[1], points[i][2] - step_size * grad[2]))\n+        points = [(x / math.sqrt(x * x + y * y + z * z), y / math.sqrt(x * x + y * y + z * z), z / math.sqrt(x * x + y * y + z * z)) for x, y, z in new_points]\n+    return points\n+\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n-\n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n-    \"\"\"\n-    rng = random.Random(1)\n-    points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\"\"\"\n+    points = fibonacci_spiral(n)\n+    points = optimize_points(points, n)\n     return points\n # OMEGA-BLOCK-END\n \n",
