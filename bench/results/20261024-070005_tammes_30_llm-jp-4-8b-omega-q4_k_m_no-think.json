 "best_diff": "--- initial\n+++ best\n@@ -7,20 +7,19 @@\n \n # OMEGA-BLOCK-START\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n-\n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n-    \"\"\"\n-    rng = random.Random(1)\n+    \"\"\"Return n points evenly distributed around the unit sphere using a\n+    Fibonacci lattice (golden\u2011spiral method). Vectors need not be normalized;\n+    they are guaranteed non\u2011zero.\"\"\"\n+    C = 1.618033988749895   # golden ratio \u03c6\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    for k in range(n):\n+        angle_step = C**k * math.pi / (math.sqrt(5) + 2*k)  # spacing factor\n+        theta = angle_step % (2 * math.pi)                # polar angle [0,\u03c0]\n+        phi   = k * C                                     # azimuthal angle\n+        r = 1.0                                          # radius fixed to unit sphere\n+        points.append((r*math.sin(theta)*math.cos(phi),\n+                       r*math.sin(theta)*math.sin(phi),\n+                       r*math.cos(theta)))\n     return points\n # OMEGA-BLOCK-END\n \n",
