 "best_diff": "--- initial\n+++ best\n@@ -11,23 +11,128 @@\n \n # OMEGA-BLOCK-START\n def solve(points, time_limit):\n-    \"\"\"Return a closed tour through all cities as a permutation of range(len(points)).\n+    n = len(points)\n+    if n == 0:\n+        return []\n+    if n == 1:\n+        return [0]\n \n-    points: list of (x, y) float tuples in the unit square; time_limit: CPU seconds\n-    allowed for this call (measured with time.process_time(); more than 1.5 x the limit\n-    makes the program invalid). The tour returns from the last city to the first.\n-    Only the Python standard library may be used.\n+    # Precompute squared distances for O(1) access later if needed, but we'll calculate on the fly for now\n+    # Given the time constraint, we must avoid O(N^2) precomputation unless N is small.\n \n-    Current method: plain nearest-neighbour construction starting at city 0.\n-    \"\"\"\n-    n = len(points)\n-    unvisited = set(range(1, n))\n+    # 1. Greedy Edge Matching Construction (Improved Initial Tour)\n+    # Instead of NN, we greedily match points based on proximity.\n+    # A simple version: start at 0, find nearest, then from the new point find nearest unvisited, etc.\n+    # This is effectively NN, but let's try a slightly different greedy approach: Prim's algorithm style MST-based path construction.\n+\n+    # Initialization: Start with the MST of the complete graph, then find a path.\n+    # Since we are aiming for a quick heuristic, we stick to a refined greedy path construction,\n+    # but instead of strictly NN, we maintain a set of available edges and pick the best one.\n+    \n     tour = [0]\n-    x, y = points[0]\n-    while unvisited:\n-        nxt = min(unvisited, key=lambda j: (points[j][0] - x) ** 2 + (points[j][1] - y) ** 2)\n-        unvisited.remove(nxt)\n-        tour.append(nxt)\n-        x, y = points[nxt]\n-    return tour\n+    visited = [False] * n\n+    visited[0] = True\n+    \n+    while len(tour) < n:\n+        current_idx = tour[-1]\n+        best_nxt = -1\n+        min_dist_sq = float('inf')\n+        \n+        # Search for the closest unvisited neighbor to the current end of the tour\n+        for j in range(n):\n+            if not visited[j]:\n+                dx = points[j][0] - points[current_idx][0]\n+                dy = points[j][1] - points[current_idx][1]\n+                dist_sq = dx*dx + dy*dy\n+                if dist_sq < min_dist_sq:\n+                    min_dist_sq = dist_sq\n+                    best_nxt = j\n+        \n+        if best_nxt != -1:\n+            tour.append(best_nxt)\n+            visited[best_nxt] = True\n+        else:\n+            # Should not happen if n > 0\n+            break\n+\n+    # Note: The simple NN construction implemented above *is* the most basic greedy path.\n+    # The inspiration suggests improving NN. The best known improvement over NN is often\n+    # a 2-opt applied to the NN result (which is what the previous version did).\n+    # To implement a *substantially different* construction, we can use a space-filling curve mapping\n+    # or a geometric decomposition, but that is complex.\n+    \n+    # Let's implement a simple 2-pass greedy approach:\n+    # Pass 1: Connect points to their nearest neighbor if they haven't been connected yet.\n+    # This is too complex to do robustly for a first attempt without exceeding time limits.\n+    \n+    # Given the constraints and the weakness of the NN construction, we will stick to NN,\n+    # but optimize the 2-opt search using incremental delta calculation (as hinted by g2),\n+    # which is a proven performance gain over the previous version's full recalculation.\n+    # This addresses the weakness of the previous implementation (O(N^2 * N) per iteration)\n+    # by making the 2-opt much faster, allowing more iterations.\n+    \n+    best_tour = list(tour)\n+\n+    # 2. 2-opt Local Search with Delta Calculation\n+    \n+    # Helper function for distance calculation (squared for comparison, true for length)\n+    def dist_sq(p1_idx, p2_idx):\n+        dx = points[p1_idx][0] - points[p2_idx][0]\n+        dy = points[p1_idx][1] - points[p2_idx][1]\n+        return dx*dx + dy*dy\n+\n+    def calculate_total_length(t):\n+        length = 0.0\n+        for i in range(n):\n+            p1 = t[i]\n+            p2 = t[(i + 1) % n]\n+            length += math.hypot(points[p1][0] - points[p2][0], points[p1][1] - points[p2][1])\n+        return length\n+\n+    current_length = calculate_total_length(best_tour)\n+    \n+    while True:\n+        time.process_time()\n+        if time.process_time() > time_limit * 0.95:\n+            break\n+            \n+        improved = False\n+        for i in range(n - 1):\n+            for k in range(i + 2, n):\n+                # 2-opt swap reverses the segment from i+1 to k\n+                # Edges affected: (t[i], t[i+1]) and (t[k], t[k+1]) become (t[i], t[k]) and (t[i+1], t[k+1])\n+                \n+                p_i = best_tour[i]\n+                p_i1 = best_tour[i+1]\n+                p_k = best_tour[k]\n+                p_k1 = best_tour[(k+1) % n]\n+                \n+                # Change in length:\n+                # Remove old edges: (p_i, p_i1) + (p_k, p_k1)\n+                # Add new edges: (p_i, p_k) + (p_i1, p_k1)\n+                \n+                old_dist = math.hypot(points[p_i][0] - points[p_i1][0], points[p_i][1] - points[p_i1][1]) + \\\n+                           math.hypot(points[p_k][0] - points[p_k1][0], points[p_k][1] - points[p_k1][1])\n+                \n+                new_dist = math.hypot(points[p_i][0] - points[p_k][0], points[p_i][1] - points[p_k][1]) + \\\n+                           math.hypot(points[p_i1][0] - points[p_k1][0], points[p_i1][1] - points[p_k1][1])\n+                \n+                delta = new_dist - old_dist\n+                \n+                if delta < 0: # Improvement found\n+                    # Perform the swap (reversing segment i+1 to k)\n+                    new_tour = list(best_tour)\n+                    new_tour[i+1:k+1] = reversed(new_tour[i+1:k+1])\n+                    \n+                    current_length += delta\n+                    best_tour = new_tour\n+                    improved = True\n+                    break # Restart search from the improved tour (greedy)\n+            if improved:\n+                break\n+        \n+        if not improved:\n+            break\n+            \n+    return best_tour\n # OMEGA-BLOCK-END\n",
