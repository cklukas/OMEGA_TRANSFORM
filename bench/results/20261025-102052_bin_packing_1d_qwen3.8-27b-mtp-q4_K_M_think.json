 "best_diff": "--- initial\n+++ best\n@@ -10,26 +10,98 @@\n import time\n \n # OMEGA-BLOCK-START\n+import math\n+import random\n+import time\n+\n+TIME_BUDGET = 1.8\n+\n def pack(sizes, capacity):\n-    \"\"\"Return a list of bins; each bin is a list of item indices into sizes.\n+    n = len(sizes)\n+    deadline = time.process_time() + TIME_BUDGET\n \n-    sizes: list of ints, each between 1 and capacity; capacity: int bin capacity.\n-    Every item index must appear in exactly one bin and the sizes in a bin must sum\n-    to at most capacity. Fewer bins is better. The call has a CPU time limit of 2.0 s\n-    (time.process_time(); more than 1.5 x the limit makes the program invalid).\n-    Only the Python standard library may be used.\n+    # Sort indices by decreasing size\n+    order = list(range(n))\n+    order.sort(key=lambda i: -sizes[i])\n \n-    Current method: next fit (open a new bin whenever the next item does not fit).\n-    \"\"\"\n-    bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n-    return bins\n+    # BFD: place each item in the bin where it fits with least remaining space\n+    bin_load = []\n+    bin_items = []\n+\n+    for i in order:\n+        s = sizes[i]\n+        best_b = -1\n+        best_slack = capacity + 1\n+        for b in range(len(bin_load)):\n+            rem = capacity - bin_load[b]\n+            if rem >= s:\n+                slack = rem - s\n+                if slack < best_slack:\n+                    best_slack = slack\n+                    best_b = b\n+        if best_b >= 0:\n+            bin_load[best_b] += s\n+            bin_items[best_b].append(i)\n+        else:\n+            bin_load.append(s)\n+            bin_items.append([i])\n+\n+    num_bins = len(bin_load)\n+\n+    # Local search: iteratively eliminate the bin with the most slack\n+    def try_eliminate(target):\n+        items = bin_items[target]\n+        m = len(items)\n+        if m == 0:\n+            bin_items.pop(target)\n+            bin_load.pop(target)\n+            return True\n+        # Place items (largest first) into other bins using best-fit\n+        items_sorted = sorted(items, key=lambda x: -sizes[x])\n+        placements = []\n+        for item in items_sorted:\n+            s = sizes[item]\n+            best = -1\n+            best_slack = capacity + 1\n+            for b in range(num_bins):\n+                if b == target:\n+                    continue\n+                rem = capacity - bin_load[b]\n+                if rem >= s:\n+                    slack = rem - s\n+                    if slack < best_slack:\n+                        best_slack = slack\n+                        best = b\n+            if best < 0:\n+                # Undo all placements\n+                for it, bb in placements:\n+                    bin_load[bb] -= sizes[it]\n+                    bin_items[bb].remove(it)\n+                return False\n+            bin_load[best] += s\n+            bin_items[best].append(item)\n+            placements.append((item, best))\n+        # Remove target bin\n+        bin_items.pop(target)\n+        bin_load.pop(target)\n+        return True\n+\n+    improved = True\n+    while improved and time.process_time() < deadline:\n+        improved = False\n+        # Find bin with most slack\n+        worst = -1\n+        worst_slack = -1\n+        for b in range(num_bins):\n+            slack = capacity - bin_load[b]\n+            if slack > worst_slack:\n+                worst_slack = slack\n+                worst = b\n+        if worst_slack <= 0:\n+            break\n+        if try_eliminate(worst):\n+            num_bins -= 1\n+            improved = True\n+\n+    return bin_items\n # OMEGA-BLOCK-END\n",
