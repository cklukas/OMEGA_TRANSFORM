 "best_diff": "--- initial\n+++ best\n@@ -21,5 +21,78 @@\n \n     Current method: alternate the sides by node index (ignores the edges entirely).\n     \"\"\"\n-    return [i % 2 for i in range(n)]\n+    # Build adjacency list representation: adj[u] = list of (v, w)\n+    adj = [[] for _ in range(n)]\n+    for u, v, w in edges:\n+        adj[u].append((v, w))\n+        adj[v].append((u, w))\n+\n+    # Track the best assignment found across all restarts\n+    best_assignment = list(range(n)) # Initial dummy assignment\n+    best_cut_weight = 0\n+    NUM_RESTARTS = 20 # Number of restarts to try\n+\n+    for _ in range(NUM_RESTARTS):\n+        # Initialize random assignment A\n+        assignment = [random.randint(0, 1) for _ in range(n)]\n+\n+        # Initial gain calculation: g_i = sum(w_ij if internal) - sum(w_ij if cut)\n+        gain = [0] * n\n+        for i in range(n):\n+            for neighbor, weight in adj[i]:\n+                if assignment[i] == assignment[neighbor]:\n+                    gain[i] += weight\n+                else:\n+                    gain[i] -= weight\n+\n+        # Local search (hill climbing) using incremental updates\n+        while True:\n+            # Find the best improving flip node\n+            best_gain = 0\n+            flip_node = -1\n+            \n+            # Scan all nodes to find the best move (O(N))\n+            for i in range(n):\n+                if gain[i] > best_gain:\n+                    best_gain = gain[i]\n+                    flip_node = i\n+\n+            # If no positive gain found, stop\n+            if best_gain <= 0:\n+                break\n+\n+            # Perform the flip\n+            i = flip_node\n+            old_side = assignment[i]\n+            assignment[i] = 1 - old_side\n+            \n+            # Update gain for i itself (flips sign)\n+            gain[i] = -best_gain\n+            \n+            # Update gains for neighbors of i (O(degree(i)))\n+            for neighbor, weight in adj[i]:\n+                # Check relative position of i and neighbor BEFORE flip of i\n+                # Note: assignment[neighbor] hasn't changed yet.\n+                \n+                # If they were on the same side (old_side == assignment[neighbor]): \n+                # i contributed +w to gain[neighbor]. After flip, contribution changes from +w to -w. Change: -2w\n+                if old_side == assignment[neighbor]:\n+                    gain[neighbor] -= 2 * weight\n+                # If they were on different sides (old_side != assignment[neighbor]):\n+                # i contributed -w to gain[neighbor]. After flip, contribution changes from -w to +w. Change: +2w\n+                else:\n+                    gain[neighbor] += 2 * weight\n+\n+        # Calculate cut weight for this run\n+        current_cut_weight = 0\n+        for u, v, w in edges:\n+            if assignment[u] != assignment[v]:\n+                current_cut_weight += w\n+\n+        # Update best assignment if current run is better\n+        if current_cut_weight > best_cut_weight:\n+            best_cut_weight = current_cut_weight\n+            best_assignment = list(assignment)\n+            \n+    return best_assignment\n # OMEGA-BLOCK-END\n",
