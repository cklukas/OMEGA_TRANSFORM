 "best_diff": "--- initial\n+++ best\n@@ -11,15 +11,38 @@\n \n # OMEGA-BLOCK-START\n def cut(n, edges):\n-    \"\"\"Return a list of n values, side[i] in {0, 1} for node i.\n-\n-    n: number of nodes (0..n-1); edges: list of (u, v, w) with 0 <= u < v < n, no\n-    duplicate pairs, integer weight 1 <= w <= 10. The cut weight is the sum of w over\n-    edges whose endpoints are on different sides; larger is better. The call has a CPU\n-    time limit of 2.0 s (time.process_time(); more than 1.5 x the limit makes the program\n-    invalid). Only the Python standard library may be used.\n-\n-    Current method: alternate the sides by node index (ignores the edges entirely).\n-    \"\"\"\n-    return [i % 2 for i in range(n)]\n+    # Build adjacency list and compute weighted degree for ordering\n+    adj = [[] for _ in range(n)]\n+    weighted_degree = [0.0] * n\n+    for u, v, w in edges:\n+        adj[u].append((v, w))\n+        adj[v].append((u, w))\n+        weighted_degree[u] += w\n+        weighted_degree[v] += w\n+    # Order nodes by decreasing weighted degree\n+    order = sorted(range(n), key=lambda i: weighted_degree[i], reverse=True)\n+    side = [0] * n\n+    assigned = [False] * n\n+    # Assign first node to side 0\n+    if n > 0:\n+        side[order[0]] = 0\n+        assigned[order[0]] = True\n+    # Greedy assignment\n+    for idx in range(1, n):\n+        i = order[idx]\n+        gain0 = 0.0   # cut weight if i is assigned to side 0\n+        gain1 = 0.0   # cut weight if i is assigned to side 1\n+        for j, w in adj[i]:\n+            if assigned[j]:\n+                if side[j] == 1:\n+                    gain0 += w   # i on 0, edge to neighbor on 1 contributes\n+                else:\n+                    gain1 += w   # i on 1, edge to neighbor on 0 contributes\n+        # Assign to side with larger gain\n+        if gain0 >= gain1:\n+            side[i] = 0\n+        else:\n+            side[i] = 1\n+        assigned[i] = True\n+    return side\n # OMEGA-BLOCK-END\n",
