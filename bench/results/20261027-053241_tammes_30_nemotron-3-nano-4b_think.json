 "best_diff": "--- initial\n+++ best\n@@ -6,21 +6,18 @@\n import random\n \n # OMEGA-BLOCK-START\n+LAT_ANGLE = 0.3668379201135792\n+LON_ANGLE = 1.0459345778001876\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n-\n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n-    \"\"\"\n-    rng = random.Random(1)\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    for i in range(5):\n+        lat = -math.pi/4 + i * LAT_ANGLE\n+        for j in range(6):\n+            lon = LON_ANGLE * j\n+            x = math.cos(lat) * math.cos(lon)\n+            y = math.cos(lat) * math.sin(lon)\n+            z = math.sin(lat)\n+            points.append((x, y, z))\n     return points\n # OMEGA-BLOCK-END\n \n",
