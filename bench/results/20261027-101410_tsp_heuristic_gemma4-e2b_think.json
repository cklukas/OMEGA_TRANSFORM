 "best_diff": "--- initial\n+++ best\n@@ -21,13 +21,109 @@\n     Current method: plain nearest-neighbour construction starting at city 0.\n     \"\"\"\n     n = len(points)\n+\n+    def dist_sq(i, j):\n+        x1, y1 = points[i]\n+        x2, y2 = points[j]\n+        return (x1 - x2)**2 + (y1 - y2)**2\n+\n+    # 1. Initial Nearest Neighbor tour construction starting at city 0\n+    tour = [0]\n     unvisited = set(range(1, n))\n-    tour = [0]\n-    x, y = points[0]\n+    current_city = 0\n+    \n     while unvisited:\n-        nxt = min(unvisited, key=lambda j: (points[j][0] - x) ** 2 + (points[j][1] - y) ** 2)\n-        unvisited.remove(nxt)\n-        tour.append(nxt)\n-        x, y = points[nxt]\n-    return tour\n+        min_dist_sq = float('inf')\n+        best_next = -1\n+        for j in unvisited:\n+            d_sq = dist_sq(current_city, j)\n+            if d_sq < min_dist_sq:\n+                min_dist_sq = d_sq\n+                best_next = j\n+        \n+        if best_next != -1:\n+            unvisited.remove(best_next)\n+            tour.append(best_next)\n+            current_city = best_next\n+        else:\n+            # Should not happen if n > 1\n+            break\n+\n+    # 2. 2-opt local search improvement\n+    \n+    def calculate_tour_length(t):\n+        length = 0.0\n+        for i in range(n):\n+            c1 = t[i]\n+            c2 = t[(i + 1) % n]\n+            length += math.sqrt(dist_sq(c1, c2))\n+        return length\n+\n+    best_tour = list(tour)\n+    best_length = calculate_tour_length(best_tour)\n+    \n+    start_time = time.process_time()\n+\n+    while time.process_time() - start_time < time_limit:\n+        improved = False\n+        current_tour = list(best_tour)\n+        current_length = best_length\n+\n+        # 2-opt local search improvement\n+        \n+        # Define maximum segment size for 2-opt swaps based on hints\n+        K = min(n, 12) \n+        \n+        while time.process_time() - start_time < time_limit:\n+            improved = False\n+            current_tour = list(best_tour)\n+            current_length = best_length\n+\n+            # Iterate over all possible starting points i\n+            for i in range(n):\n+                # Iterate over segment lengths k <= K\n+                for k in range(1, K + 1):\n+                    j = i + k\n+                    if j >= n:\n+                        break\n+                    \n+                    # Check 2-opt swap: reverse segment tour[i:j+1]\n+                    # Calculate change in length incrementally\n+                    \n+                    # Cost of edges broken: (T[i-1], T[i]) and (T[j], T[j+1])\n+                    # Cost of edges added: (T[i-1], T[j]) and (T[i], T[j+1])\n+                    \n+                    # We need helper access to boundary elements, handling wrap around implicitly via modulo or explicit checks.\n+                    \n+                    # Calculate incremental cost change (O(1))\n+                    prev_idx = (i - 1 + n) % n\n+                    next_idx = (j + 1) % n\n+                    \n+                    # Cost of edges broken: (T[i-1], T[i]) and (T[j], T[j+1])\n+                    old_edge_cost = math.sqrt(dist_sq(current_tour[prev_idx], current_tour[i])) + math.sqrt(dist_sq(current_tour[j], current_tour[next_idx]))\n+                    \n+                    # Cost of edges added: (T[i-1], T[j]) and (T[i], T[j+1])\n+                    reversed_segment = current_tour[i:j+1][::-1]\n+                    new_edge_cost = math.sqrt(dist_sq(current_tour[prev_idx], reversed_segment[0])) + math.sqrt(dist_sq(reversed_segment[-1], current_tour[next_idx]))\n+                    \n+                    # Since the internal segment cost is invariant under reversal, delta_cost = new_edge_cost - old_edge_cost\n+                    delta_cost = new_edge_cost - old_edge_cost\n+\n+                    if delta_cost < 0:\n+                        best_tour = current_tour[:i] + reversed_segment + current_tour[j+1:]\n+                        best_length += delta_cost\n+                        best_length = best_length # Keep best_length updated incrementally\n+                        improved = True\n+                        # Restart search from the improved tour for faster convergence (First Improvement strategy)\n+                        break \n+                if improved:\n+                    break\n+            \n+            if not improved:\n+                break\n+        \n+        if not improved:\n+            break\n+\n+    return best_tour\n # OMEGA-BLOCK-END\n",
