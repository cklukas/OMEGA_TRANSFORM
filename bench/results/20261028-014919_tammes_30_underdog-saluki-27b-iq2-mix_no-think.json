 "best_diff": "--- initial\n+++ best\n@@ -7,20 +7,16 @@\n \n # OMEGA-BLOCK-START\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n-\n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n+    \"\"\"Return a list of n points (x, y, z) on the unit sphere using a\n+    Fibonacci (golden-spiral) sphere for good uniformity.\n     \"\"\"\n-    rng = random.Random(1)\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    golden = (1 + math.sqrt(5)) / 2.0\n+    for i in range(n):\n+        z = 1.0 - 2.0 * i / (n - 1)\n+        r = math.sqrt(1.0 - z * z)\n+        phi = i * 2 * math.pi / golden\n+        points.append((r * math.cos(phi), r * math.sin(phi), z))\n     return points\n # OMEGA-BLOCK-END\n \n",
