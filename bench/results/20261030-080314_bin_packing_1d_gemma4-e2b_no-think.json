 "best_diff": "--- initial\n+++ best\n@@ -21,15 +21,41 @@\n \n     Current method: next fit (open a new bin whenever the next item does not fit).\n     \"\"\"\n+    # Sort items by size in descending order, keeping track of original indices\n+    sorted_items = sorted(enumerate(sizes), key=lambda x: x[1], reverse=True)\n+    \n+    # bins will store lists of item indices for each bin\n     bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n-    return bins\n+    \n+    # Initialize bins structure: store (load, list_of_indices)\n+    bin_states = []\n+    \n+    for original_index, size in sorted_items:\n+        # Try to fit the item into an existing bin\n+        best_fit_index = -1\n+        min_remaining_space = capacity + 1\n+        \n+        for i, (load, indices) in enumerate(bin_states):\n+            if load + size <= capacity:\n+                remaining = capacity - (load + size)\n+                # Best Fit Decreasing: minimize remaining space (maximize load)\n+                if remaining < min_remaining_space:\n+                    min_remaining_space = remaining\n+                    best_fit_index = i\n+        \n+        if best_fit_index != -1:\n+            # Place item in the best fitting existing bin\n+            _, indices = bin_states[best_fit_index]\n+            indices.append(original_index)\n+            bin_states[best_fit_index] = (bin_states[best_fit_index][0] + size, indices)\n+        else:\n+            # Open a new bin\n+            bin_states.append((size, [original_index]))\n+            \n+    # Extract just the indices from the final bin states\n+    final_bins = []\n+    for _, indices in bin_states:\n+        final_bins.append(sorted(indices))\n+        \n+    return final_bins\n # OMEGA-BLOCK-END\n",
