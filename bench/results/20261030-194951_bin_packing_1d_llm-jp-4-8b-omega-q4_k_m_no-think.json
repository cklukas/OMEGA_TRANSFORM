 "best_diff": "--- initial\n+++ best\n@@ -13,23 +13,29 @@\n def pack(sizes, capacity):\n     \"\"\"Return a list of bins; each bin is a list of item indices into sizes.\n \n-    sizes: list of ints, each between 1 and capacity; capacity: int bin capacity.\n-    Every item index must appear in exactly one bin and the sizes in a bin must sum\n-    to at most capacity. Fewer bins is better. The call has a CPU time limit of 2.0 s\n-    (time.process_time(); more than 1.5 x the limit makes the program invalid).\n-    Only the Python standard library may be used.\n+    sizes: list of ints, each between 1 and capacivity; capacivity: int bin capacity.\n+    ... (docstring unchanged) ...\n \n-    Current method: next fit (open a new bin whenever the next item does not fit).\n+    Current method switched from next\u2011fit to first\u2011fit decreasing (FFD):\n+    items are sorted descending by size once, then placed into the first bin that fits.\n+    This is fast O(n\u00b7b) and stays well within the 2\u202fs CPU budget even for 1000 items.\n     \"\"\"\n-    bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n+    bins = []               # list of bins (each bin stores item indices)\n+    loads = []              # parallel list storing current load of each bin\n+    remaining_items = sorted(enumerate(sizes), key=lambda x: -x[1])   # sort by size desc., keep original index\n+    \n+    for idx, s in remaining_items:\n+        placed = False\n+        for b_idx, cur_load in enumerate(loads):\n+            if cur_load + s <= capacity:\n+                # put item into this bin\n+                bins[b_idx].append(idx)\n+                loads[b_idx] += s\n+                placed = True\n+                break\n+        if not placed:\n+            # open a new bin for the item\n+            bins.append([idx])\n+            loads.append(s)\n     return bins\n # OMEGA-BLOCK-END\n",
