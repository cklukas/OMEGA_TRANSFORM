 "best_diff": "--- initial\n+++ best\n@@ -19,17 +19,91 @@\n     (time.process_time(); more than 1.5 x the limit makes the program invalid).\n     Only the Python standard library may be used.\n \n-    Current method: next fit (open a new bin whenever the next item does not fit).\n+    Current method: first-fit decreasing with local search optimization.\n     \"\"\"\n+    start_time = time.process_time()\n+    \n+    # Create list of (size, index) pairs and sort by size descending\n+    indexed_sizes = [(sizes[i], i) for i in range(len(sizes))]\n+    indexed_sizes.sort(reverse=True)\n+    \n+    # Initialize bins\n     bins = []\n-    current, load = [], 0\n-    for i, s in enumerate(sizes):\n-        if load + s > capacity:\n-            bins.append(current)\n-            current, load = [], 0\n-        current.append(i)\n-        load += s\n-    if current:\n-        bins.append(current)\n-    return bins\n+    bin_loads = []  # track current load of each bin\n+    \n+    # First-fit decreasing placement\n+    for size, index in indexed_sizes:\n+        placed = False\n+        best_bin = -1\n+        min_space = capacity + 1\n+        \n+        # Find the best bin to place this item\n+        for i in range(len(bins)):\n+            if bin_loads[i] + size <= capacity and (capacity - bin_loads[i] - size) < min_space:\n+                min_space = capacity - bin_loads[i] - size\n+                best_bin = i\n+                \n+        if best_bin != -1:\n+            bins[best_bin].append(index)\n+            bin_loads[best_bin] += size\n+        else:\n+            # Create new bin\n+            bins.append([index])\n+            bin_loads.append(size)\n+    \n+    # Local search optimization\n+    def evaluate_bins():\n+        return sum(1 for load in bin_loads if load > 0)\n+        \n+    def local_search():\n+        nonlocal bins, bin_loads\n+        \n+        # Try to improve by swapping items between bins\n+        improved = True\n+        while improved and time.process_time() - start_time < 1.8:\n+            improved = False\n+            best_bins = evaluate_bins()\n+            \n+            for i in range(len(bins)):\n+                if len(bins[i]) == 0:\n+                    continue\n+                for j in range(len(bins[i])):\n+                    item_index = bins[i][j]\n+                    item_size = sizes[item_index]\n+                    \n+                    # Try to move this item to another bin\n+                    old_bin_load = bin_loads[i]\n+                    new_bin_load = old_bin_load - item_size\n+                    \n+                    for k in range(len(bins)):\n+                        if k == i or bin_loads[k] + item_size > capacity:\n+                            continue\n+                        \n+                        # Test swap\n+                        old_bin_load = bin_loads[i]\n+                        new_bin_load = bin_loads[i] - item_size\n+                        new_k_load = bin_loads[k] + item_size\n+                        \n+                        if new_bin_load >= 0 and new_k_load <= capacity:\n+                            bins[i].pop(j)\n+                            bins[k].append(item_index)\n+                            bin_loads[i] = new_bin_load\n+                            bin_loads[k] = new_k_load\n+                            \n+                            new_bins = evaluate_bins()\n+                            if new_bins < best_bins:\n+                                improved = True\n+                                best_bins = new_bins\n+                            else:\n+                                # Revert swap\n+                                bins[i].insert(j, item_index)\n+                                bins[k].pop()\n+                                bin_loads[i] = old_bin_load\n+                                bin_loads[k] = bin_loads[k] - item_size\n+    \n+    local_search()\n+    \n+    # Remove empty bins\n+    final_bins = [b for b in bins if len(b) > 0]\n+    return final_bins\n # OMEGA-BLOCK-END\n",
