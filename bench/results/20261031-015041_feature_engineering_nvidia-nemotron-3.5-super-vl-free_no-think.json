 "best_diff": "--- initial\n+++ best\n@@ -9,6 +9,9 @@\n import math\n \n # OMEGA-BLOCK-START\n+MAXF = 1e100\n+LOGMAX = math.log(MAXF)\n+\n def features(row):\n     \"\"\"Return the feature vector (a list of at most 30 finite floats) for one row.\n \n@@ -19,7 +22,35 @@\n     features (they are standardized and a bias is added), so nonlinear structure only\n     helps if a feature expresses it. Only the Python standard library may be used.\n \n-    Current method: the raw inputs.\n+    Current method: raw inputs plus pairwise products among x1/x2/x6 plus x3*x6,\n+    squares of x1/x2/x4/x5/x6 and x3^2, log(x3), and sign(x1*x2) so a linear model\n+    can capture quadratic and XOR-like structure.\n     \"\"\"\n-    return list(row)\n+    x1, x2, x3, x4, x5, x6 = row\n+\n+    def cap(v):\n+        if not math.isfinite(v):\n+            return 0.0\n+        return max(-MAXF, min(MAXF, v))\n+\n+    x1sq = cap(x1 * x1)\n+    x2sq = cap(x2 * x2)\n+    x4sq = cap(x4 * x4)\n+    x5sq = cap(x5 * x5)\n+    x6sq = cap(x6 * x6)\n+    x3sq = cap(x3 * x3)\n+\n+    x3log = cap(math.log(x3) if x3 > 0 else 0.0)\n+\n+    s12 = x1 * x2\n+    sign12 = 1.0 if s12 > 0 else (-1.0 if s12 < 0 else 0.0)\n+\n+    feats = [\n+        cap(x1), cap(x2), cap(x3), cap(x4), cap(x5), cap(x6),\n+        x1sq, x2sq, x4sq, x5sq, x6sq, x3sq,\n+        cap(x1 * x2), cap(x1 * x6), cap(x2 * x6), cap(x3 * x6),\n+        cap(x4 * x5),\n+        x3log, sign12,\n+    ]\n+    return [cap(v) for v in feats]\n # OMEGA-BLOCK-END\n",
