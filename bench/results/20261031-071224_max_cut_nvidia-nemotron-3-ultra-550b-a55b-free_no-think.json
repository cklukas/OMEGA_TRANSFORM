 "best_diff": "--- initial\n+++ best\n@@ -10,6 +10,16 @@\n import time\n \n # OMEGA-BLOCK-START\n+import time\n+\n+# Tabu search parameters\n+TABU_TENURE_BASE = 0.15  # base tenure as fraction of n\n+TABU_RANDOM_RANGE = 5    # random addition to tenure\n+RESTART_FRACTION = 0.07  # fraction of nodes to flip on restart\n+MAX_RESTARTS = 150       # maximum number of restarts\n+ADAPTIVE_RESTART_THRESHOLD = 5  # restarts without improvement before adaptive perturbation\n+MEMEtic_CROSSOVER_FRACTION = 0.3  # fraction of nodes to take from second best solution (unused, kept for reference)\n+\n def cut(n, edges):\n     \"\"\"Return a list of n values, side[i] in {0, 1} for node i.\n \n@@ -19,7 +29,178 @@\n     time limit of 2.0 s (time.process_time(); more than 1.5 x the limit makes the program\n     invalid). Only the Python standard library may be used.\n \n-    Current method: alternate the sides by node index (ignores the edges entirely).\n+    Method: greedy construction + tabu search with random restarts and incremental gain updates.\n     \"\"\"\n-    return [i % 2 for i in range(n)]\n+    start_time = time.process_time()\n+    TIME_LIMIT = 1.9  # leave margin for safety\n+\n+    # Build adjacency list\n+    adj = [[] for _ in range(n)]\n+    for u, v, w in edges:\n+        adj[u].append((v, w))\n+        adj[v].append((u, w))\n+\n+    def compute_cut_weight(side_arr):\n+        \"\"\"Compute total cut weight for a given assignment.\"\"\"\n+        total = 0\n+        for u, v, w in edges:\n+            if side_arr[u] != side_arr[v]:\n+                total += w\n+        return total\n+\n+    def greedy_construct():\n+        \"\"\"Greedy construction: place nodes on side that cuts more weight to placed nodes.\"\"\"\n+        side_arr = [0] * n\n+        placed = [False] * n\n+        order = list(range(n))\n+        random.shuffle(order)\n+        \n+        for u in order:\n+            gain0 = 0\n+            gain1 = 0\n+            for v, w in adj[u]:\n+                if placed[v]:\n+                    if side_arr[v] == 0:\n+                        gain0 += w\n+                    else:\n+                        gain1 += w\n+            side_arr[u] = 0 if gain0 >= gain1 else 1\n+            placed[u] = True\n+        return side_arr\n+\n+    def compute_gains(side_arr):\n+        \"\"\"Compute initial gains for all nodes.\"\"\"\n+        gain_arr = [0] * n\n+        for u in range(n):\n+            g = 0\n+            for v, w in adj[u]:\n+                if side_arr[u] == side_arr[v]:\n+                    g += w\n+                else:\n+                    g -= w\n+            gain_arr[u] = g\n+        return gain_arr\n+\n+    def tabu_search(side_arr, gain_arr, time_left):\n+        \"\"\"Tabu search with aspiration criteria using incremental weight tracking.\"\"\"\n+        tabu_tenure = int(n * TABU_TENURE_BASE) + random.randint(0, TABU_RANDOM_RANGE)\n+        tabu_list = [-1] * n  # iteration when node becomes non-tabu\n+        best_side = side_arr[:]\n+        best_weight = compute_cut_weight(side_arr)\n+        current_weight = best_weight\n+        iteration = 0\n+        \n+        while time.process_time() - start_time < time_left:\n+            iteration += 1\n+            best_gain = -float('inf')\n+            best_u = -1\n+            \n+            # Find best non-tabu move (or aspiration)\n+            for u in range(n):\n+                if gain_arr[u] > best_gain:\n+                    if tabu_list[u] < iteration or (gain_arr[u] > 0 and current_weight + gain_arr[u] > best_weight):\n+                        best_gain = gain_arr[u]\n+                        best_u = u\n+            \n+            if best_u == -1:\n+                break\n+                \n+            # Flip best_u\n+            side_arr[best_u] ^= 1\n+            tabu_list[best_u] = iteration + tabu_tenure\n+            \n+            # Update gains of neighbors\n+            for v, w in adj[best_u]:\n+                if side_arr[v] == side_arr[best_u]:  # now same side\n+                    gain_arr[v] += 2 * w\n+                else:  # now different sides\n+                    gain_arr[v] -= 2 * w\n+            gain_arr[best_u] = -gain_arr[best_u]\n+            \n+            # Update current weight incrementally\n+            current_weight += best_gain\n+            \n+            # Check if new best solution\n+            if current_weight > best_weight:\n+                best_weight = current_weight\n+                best_side = side_arr[:]\n+        \n+        return best_side, best_weight\n+\n+    # Initial greedy construction\n+    best_side = greedy_construct()\n+    best_gain = compute_gains(best_side)\n+    best_weight = compute_cut_weight(best_side)\n+    \n+    # Keep track of top solutions for memetic crossover\n+    top_solutions = [(best_weight, best_side[:])]\n+    \n+    # Initial tabu search\n+    current_side, current_weight = tabu_search(best_side[:], best_gain[:], TIME_LIMIT * 0.3)\n+    if current_weight > best_weight:\n+        best_weight = current_weight\n+        best_side = current_side[:]\n+        top_solutions.append((best_weight, best_side[:]))\n+        top_solutions.sort(reverse=True)\n+        if len(top_solutions) > 5:\n+            top_solutions.pop()\n+    \n+    # Random restarts with perturbations and adaptive strategies\n+    restarts = 0\n+    restarts_without_improvement = 0\n+    while time.process_time() - start_time < TIME_LIMIT and restarts < MAX_RESTARTS:\n+        # Adaptive perturbation: increase flips if stuck\n+        if restarts_without_improvement >= ADAPTIVE_RESTART_THRESHOLD:\n+            perturbation_fraction = RESTART_FRACTION * (1 + restarts_without_improvement * 0.5)\n+        else:\n+            perturbation_fraction = RESTART_FRACTION\n+        \n+        # Memetic crossover: occasionally combine two good solutions\n+        if len(top_solutions) >= 2 and random.random() < 0.3:\n+            # Crossover between best and second best\n+            parent1 = top_solutions[0][1]\n+            parent2 = top_solutions[1][1]\n+            perturbed_side = [0] * n\n+            for u in range(n):\n+                if parent1[u] == parent2[u]:\n+                    perturbed_side[u] = parent1[u]\n+                else:\n+                    perturbed_side[u] = random.choice([0, 1])\n+            # Add some random flips\n+            num_extra_flips = max(1, min(int(n * 0.05), n))\n+            flip_nodes = random.sample(range(n), num_extra_flips)\n+            for u in flip_nodes:\n+                perturbed_side[u] ^= 1\n+        else:\n+            # Standard perturbation\n+            perturbed_side = best_side[:]\n+            num_flips = max(1, min(int(n * perturbation_fraction), n))\n+            flip_nodes = random.sample(range(n), num_flips)\n+            for u in flip_nodes:\n+                perturbed_side[u] ^= 1\n+        \n+        # Recompute gains for perturbed solution\n+        perturbed_gain = compute_gains(perturbed_side)\n+        \n+        # Tabu search from perturbed solution\n+        time_left = TIME_LIMIT - (time.process_time() - start_time)\n+        if time_left <= 0:\n+            break\n+            \n+        current_side, current_weight = tabu_search(perturbed_side, perturbed_gain, time_left)\n+        \n+        if current_weight > best_weight:\n+            best_weight = current_weight\n+            best_side = current_side[:]\n+            top_solutions.append((best_weight, best_side[:]))\n+            top_solutions.sort(reverse=True)\n+            if len(top_solutions) > 5:\n+                top_solutions.pop()\n+            restarts_without_improvement = 0\n+        else:\n+            restarts_without_improvement += 1\n+        \n+        restarts += 1\n+\n+    return best_side\n # OMEGA-BLOCK-END\n",
