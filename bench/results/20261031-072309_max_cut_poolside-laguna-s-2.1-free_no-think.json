 "best_diff": "--- initial\n+++ best\n@@ -10,16 +10,128 @@\n import time\n \n # OMEGA-BLOCK-START\n+import math\n+import random\n+import time\n+\n+TIME_LIMIT = 1.8\n+SEED = 31\n+PERTURB_FRAC = 0.08\n+\n def cut(n, edges):\n     \"\"\"Return a list of n values, side[i] in {0, 1} for node i.\n \n-    n: number of nodes (0..n-1); edges: list of (u, v, w) with 0 <= u < v < n, no\n-    duplicate pairs, integer weight 1 <= w <= 10. The cut weight is the sum of w over\n-    edges whose endpoints are on different sides; larger is better. The call has a CPU\n-    time limit of 2.0 s (time.process_time(); more than 1.5 x the limit makes the program\n-    invalid). Only the Python standard library may be used.\n+    Greedy construction followed by one-flip local search using incremental gain\n+    updates and perturbation restarts, tuned to the CPU time budget.\n+    \"\"\"\n+    rng = random.Random(SEED)\n+    adj = [[] for _ in range(n)]\n+    total_w = 0\n+    for u, v, w in edges:\n+        adj[u].append((v, w))\n+        adj[v].append((u, w))\n+        total_w += w\n \n-    Current method: alternate the sides by node index (ignores the edges entirely).\n-    \"\"\"\n-    return [i % 2 for i in range(n)]\n+    deadline = time.process_time() + TIME_LIMIT\n+\n+    def compute_cut(side):\n+        total = 0\n+        for u, v, w in edges:\n+            if side[u] != side[v]:\n+                total += w\n+        return total\n+\n+    def build_greedy(order, rng):\n+        side = [0] * n\n+        for i in order:\n+            w0 = 0\n+            w1 = 0\n+            for nb, wt in adj[i]:\n+                if side[nb] == 0:\n+                    w0 += wt\n+                else:\n+                    w1 += wt\n+            if w0 > w1:\n+                side[i] = 0\n+            elif w1 > w0:\n+                side[i] = 1\n+            else:\n+                side[i] = rng.randint(0, 1)\n+        return side\n+\n+    def compute_gains(side):\n+        gain = [0] * n\n+        for i in range(n):\n+            own = 0\n+            other = 0\n+            for nb, wt in adj[i]:\n+                if side[nb] == side[i]:\n+                    own += wt\n+                else:\n+                    other += wt\n+            gain[i] = own - other\n+        return gain\n+\n+    def local_search(side, gain):\n+        while True:\n+            best_i = -1\n+            best_g = 0\n+            for i in range(n):\n+                if gain[i] < best_g:\n+                    best_g = gain[i]\n+                    best_i = i\n+            if best_i < 0:\n+                break\n+            i = best_i\n+            s = side[i]\n+            side[i] = 1 - s\n+            gain[i] = -gain[i]\n+            for nb, wt in adj[i]:\n+                if side[nb] == s:\n+                    gain[nb] += 2 * wt\n+                else:\n+                    gain[nb] -= 2 * wt\n+\n+    def perturb(side, rng):\n+        k = max(1, int(n * PERTURB_FRAC))\n+        for i in rng.sample(range(n), k):\n+            side[i] = 1 - side[i]\n+\n+    order = sorted(range(n), key=lambda x: len(adj[x]), reverse=True)\n+\n+    best_side = None\n+    best_cut = -1\n+\n+    # First greedy + local search.\n+    side = build_greedy(order, rng)\n+    gain = compute_gains(side)\n+    local_search(side, gain)\n+    cur_cut = compute_cut(side)\n+    if cur_cut > best_cut:\n+        best_cut = cur_cut\n+        best_side = list(side)\n+\n+    # Randomized restarts with perturbation from best.\n+    while time.process_time() < deadline:\n+        rng.shuffle(order)\n+        side = build_greedy(order, rng)\n+        gain = compute_gains(side)\n+        local_search(side, gain)\n+        cur_cut = compute_cut(side)\n+        if cur_cut > best_cut:\n+            best_cut = cur_cut\n+            best_side = list(side)\n+        if best_side is not None:\n+            side = list(best_side)\n+            perturb(side, rng)\n+            gain = compute_gains(side)\n+            local_search(side, gain)\n+            cur_cut = compute_cut(side)\n+            if cur_cut > best_cut:\n+                best_cut = cur_cut\n+                best_side = list(side)\n+\n+    if best_side is None:\n+        best_side = [0] * n\n+    return best_side\n # OMEGA-BLOCK-END\n",
