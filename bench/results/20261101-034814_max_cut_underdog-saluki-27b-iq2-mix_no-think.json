 "best_diff": "--- initial\n+++ best\n@@ -10,16 +10,162 @@\n import time\n \n # OMEGA-BLOCK-START\n+PAIR_SEARCH_LIMIT = 40\n+ALLOW_NEGATIVE = True\n+\n def cut(n, edges):\n-    \"\"\"Return a list of n values, side[i] in {0, 1} for node i.\n+    \"\"\"Return a list of n values, side[i] in {0, 1}.\n \n-    n: number of nodes (0..n-1); edges: list of (u, v, w) with 0 <= u < v < n, no\n-    duplicate pairs, integer weight 1 <= w <= 10. The cut weight is the sum of w over\n-    edges whose endpoints are on different sides; larger is better. The call has a CPU\n-    time limit of 2.0 s (time.process_time(); more than 1.5 x the limit makes the program\n-    invalid). Only the Python standard library may be used.\n+    Heuristic: start from alternating split; run a 3-opt (two-node exchange)\n+    neighborhood with tabu memory, picking the best allowed move (aspiration),\n+    until time budget is exhausted.\n+    \"\"\"\n+    import math\n+    import random\n+    import time\n \n-    Current method: alternate the sides by node index (ignores the edges entirely).\n-    \"\"\"\n-    return [i % 2 for i in range(n)]\n+    # Build adjacency: adj[u] = list of (v, w)\n+    adj = [[] for _ in range(n)]\n+    for u, v, w in edges:\n+        adj[u].append((v, w))\n+        adj[v].append((u, w))\n+\n+    side = [i % 2 for i in range(n)]\n+\n+    # cutw = sum over edges w * (side[u] != side[v])\n+    cutw = 0\n+    for u, v, w in edges:\n+        if side[u] != side[v]:\n+            cutw += w\n+\n+    # gain[i] = (weight to same side) - (weight to other side)\n+    # flip i alone changes cut by gain[i] // 2\n+    gain = [0] * n\n+    for u in range(n):\n+        su = side[u]\n+        s = 0\n+        o = 0\n+        for v, w in adj[u]:\n+            if side[v] == su:\n+                s += w\n+            else:\n+                o += w\n+        gain[u] = s - o\n+\n+    deadline = time.process_time() + 1.9\n+\n+    # Tabu memory: forbid re-selecting a node for a window of steps.\n+    tabu = [[False] * 2 for _ in range(n)]  # tabu[i][side] True if i is tabu on that side\n+    tabu_step = [0] * n\n+    tenure = max(1, n // 10)\n+\n+    start_time = time.process_time()\n+    best_cutw = cutw\n+    best_side = side[:]\n+\n+    # 3-opt: pick two distinct nodes i, j and flip both.\n+    # Change in cut:\n+    #  For edge (a,b) with both endpoints flipped: unchanged.\n+    #  For edge (a,b) with exactly one endpoint flipped: contribution flips.\n+    # Total change = sum over edges with exactly one flipped endpoint (new - old)\n+    #  = -2 * (sum over edges with exactly one flipped endpoint) * (old_contribution)\n+    #  where old_contribution = w if side[a]!=side[b] else 0.\n+    # Equivalently, let S be the set of edges incident to exactly one of {i,j}.\n+    # change = -2 * (weight of edges in S that are currently crossing)\n+    # but edges with both endpoints flipped keep their crossing status.\n+    # Let W_cross(i) = weight of edges from i to nodes not on side[i]\n+    # Let W_same(i)  = weight of edges from i to nodes on side[i]\n+    # For pair (i,j):\n+    #   Edges from i to j: both flip -> status unchanged.\n+    #   Edges from i to others: exactly one flips -> status flips.\n+    #   Edges from j to others (not i): exactly one flips -> status flips.\n+    #   Edges from i to j counted once.\n+    # New status of edge (i, v) where v != j: flips.\n+    # Old crossing weight for these = W_cross(i) - w_ij (if j is on the other side of i)\n+    #   or W_cross(i) (if j is on the same side as i)\n+    # Simpler: compute per-pair directly using neighbor lists.\n+\n+    def pair_change(i, j):\n+        \"\"\"Return change in cut weight when flipping both i and j.\"\"\"\n+        # Edges from i to nodes not in {i,j}:\n+        #   contribution flips.\n+        s = 0\n+        for v, w in adj[i]:\n+            if v == j:\n+                continue\n+            if side[i] != side[v]:\n+                # Currently crossing, will become non-crossing\n+                s -= w\n+            else:\n+                # Currently non-crossing, will become crossing\n+                s += w\n+        # Edges from j to nodes not in {i,j}:\n+        for v, w in adj[j]:\n+            if v == i:\n+                continue\n+            if side[j] != side[v]:\n+                s -= w\n+            else:\n+                s += w\n+        # Edge (i,j): both flip, status unchanged -> no contribution.\n+        return s\n+\n+    while time.process_time() < deadline:\n+        # Find best allowed pair (i,j) to flip.\n+        best = None\n+        best_delta = -10**18\n+        for i in range(n):\n+            if tabu[i][side[i]]:\n+                continue\n+            si = side[i]\n+            # Limit j search to PAIR_SEARCH_LIMIT nodes after i\n+            j_end = min(i + 1 + PAIR_SEARCH_LIMIT, n)\n+            for j in range(i + 1, j_end):\n+                if tabu[j][side[j]]:\n+                    continue\n+                d = pair_change(i, j)\n+                if d > best_delta:\n+                    best_delta = d\n+                    best = (i, j)\n+        if ALLOW_NEGATIVE and best is not None and best_delta > 0:\n+            pass\n+        if best is None:\n+            # Only forbidden moves: pick a random pair ignoring tabu.\n+            if time.process_time() - start_time > 0.5:\n+                break\n+            for _ in range(20):\n+                i = random.randrange(n)\n+                j = random.randrange(n)\n+                if i == j:\n+                    continue\n+                d = pair_change(i, j)\n+                if d > best_delta:\n+                    best_delta = d\n+                    best = (i, j)\n+            if best is None:\n+                break\n+\n+        i, j = best\n+        # Mark both as tabu on their new side.\n+        tabu[i][side[i]] = True\n+        tabu[j][side[j]] = True\n+        tabu_step[i] = 0\n+        tabu_step[j] = 0\n+\n+        # Apply flip.\n+        side[i] = 1 - side[i]\n+        side[j] = 1 - side[j]\n+        cutw += best_delta\n+\n+        if cutw > best_cutw:\n+            best_cutw = cutw\n+            best_side = side[:]\n+\n+        # Expire tabu entries after tenure steps.\n+        for k in range(n):\n+            if tabu[k][side[k]] and tabu_step[k] >= tenure:\n+                tabu[k][side[k]] = False\n+            tabu_step[k] += 1\n+\n+    return best_side\n # OMEGA-BLOCK-END\n",
