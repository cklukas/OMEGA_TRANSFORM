 "best_diff": "--- initial\n+++ best\n@@ -7,20 +7,18 @@\n \n # OMEGA-BLOCK-START\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n-\n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n-    \"\"\"\n-    rng = random.Random(1)\n+    \n+    # Omega-constant: golden ratio for Fibonacci spherical code\n+    GOLDEN = 0.618033988749894848204586834365638117720\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    for i in range(n):\n+        # Fibonacci angle progression\n+        theta = math.atan(GOLDEN) * i\n+        x = math.cos(theta)\n+        y = math.sin(theta)\n+        z = 0.0\n+        points.append((x, y, z))\n+    \n     return points\n # OMEGA-BLOCK-END\n \n",
