 "best_diff": "--- initial\n+++ best\n@@ -11,16 +11,33 @@\n \n     Vectors need not be normalized (the evaluator normalizes them), but none may be\n     zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n+    start places points using a Fibonacci spiral and then applies a repulsive force.\n     \"\"\"\n     rng = random.Random(1)\n     points = []\n+    spiral_angle = (1 + math.sqrt(5)) / 2\n     for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+        theta = _ * 2 * math.pi / n\n+        phi = rng.uniform(0, 2 * math.pi)\n+        s = math.sqrt(1.0 - rng.uniform(-1.0, 1.0) ** 2)\n+        points.append((s * math.cos(theta), s * math.sin(theta), rng.uniform(-1.0, 1.0)))\n+\n+    # Repulsive force step\n+    for i in range(n):\n+        for j in range(i + 1, n):\n+            p1, p2 = points[i], points[j]\n+            d = (p1[0] - p2[0]) ** 2 + (p1[1] - p2[1]) ** 2 + (p1[2] - p2[2]) ** 2\n+            if d == 0:\n+                continue\n+            dist = math.sqrt(d)\n+            move_step = 0.03\n+            points[i] = (points[i][0] + move_step * (p2[0] - p1[0]) / dist,\n+                         points[i][1] + move_step * (p2[1] - p1[1]) / dist,\n+                         points[i][2] + move_step * (p2[2] - p1[2]) / dist)\n+            points[j] = (points[j][0] - move_step * (p1[0] - p2[0]) / dist,\n+                         points[j][1] - move_step * (p1[1] - p2[1]) / dist,\n+                         points[j][2] - move_step * (p1[2] - p2[2]) / dist)\n+\n     return points\n # OMEGA-BLOCK-END\n \n",
