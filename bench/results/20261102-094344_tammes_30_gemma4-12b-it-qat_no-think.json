 "best_diff": "--- initial\n+++ best\n@@ -14,13 +14,20 @@\n     start draws uniformly random points with a fixed seed, so some pairs end up\n     close together.\n     \"\"\"\n-    rng = random.Random(1)\n+    # Fibonacci spiral (golden spiral) distribution\n+    phi_gold = (1 + 5**0.5) / 2\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    for i in range(n):\n+        # z goes from 1 to -1\n+        z = 1 - (2 * i / (n - 1))\n+        # Handle edge cases for n=1\n+        if n == 1: z = 0\n+        \n+        # Radius at this z\n+        r = math.sqrt(max(0, 1 - z**2))\n+        # Golden spiral angle\n+        theta = 2 * math.pi * i * phi_gold\n+        points.append((r * math.cos(theta), r * math.sin(theta), z))\n     return points\n # OMEGA-BLOCK-END\n \n",
