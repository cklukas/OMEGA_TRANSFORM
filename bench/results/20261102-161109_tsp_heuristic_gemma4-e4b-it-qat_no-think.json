 "best_diff": "--- initial\n+++ best\n@@ -18,9 +18,11 @@\n     makes the program invalid). The tour returns from the last city to the first.\n     Only the Python standard library may be used.\n \n-    Current method: plain nearest-neighbour construction starting at city 0.\n+    Current method: 2-opt local search starting from nearest neighbour construction.\n     \"\"\"\n     n = len(points)\n+    \n+    # Nearest neighbour construction\n     unvisited = set(range(1, n))\n     tour = [0]\n     x, y = points[0]\n@@ -29,5 +31,67 @@\n         unvisited.remove(nxt)\n         tour.append(nxt)\n         x, y = points[nxt]\n-    return tour\n+\n+    def get_dist_sq(p1_idx, p2_idx):\n+        x1, y1 = points[p1_idx]\n+        x2, y2 = points[p2_idx]\n+        return (x1 - x2) ** 2 + (y1 - y2) ** 2\n+\n+    def calculate_tour_length(current_tour):\n+        length = 0.0\n+        for i in range(n):\n+            p1_idx = current_tour[i]\n+            p2_idx = current_tour[(i + 1) % n]\n+            x1, y1 = points[p1_idx]\n+            x2, y2 = points[p2_idx]\n+            length += math.hypot(x1 - x2, y1 - y2)\n+        return length\n+\n+    best_tour = list(tour)\n+    best_length = calculate_tour_length(best_tour)\n+    \n+    start_time = time.process_time()\n+    \n+    while time.process_time() - start_time < time_limit * 0.95:\n+        improved = False\n+        for i in range(n - 1):\n+            for k in range(i + 1, n):\n+                # Check 2-opt swap: (i -> i+1) and (k -> k+1) replaced by (i -> k) and (i+1 -> k+1)\n+                \n+                # Indices in the tour:\n+                # i and i+1 are the first pair of edges to be replaced\n+                # k and k+1 are the second pair of edges to be replaced\n+                \n+                # The swap involves reversing the segment between i+1 and k\n+                # New tour: T[0..i] + reversed(T[i+1..k]) + T[k+1..n-1]\n+                \n+                # Check only if the swap is valid and potentially beneficial\n+                \n+                # Get points involved\n+                p_i = best_tour[i]\n+                p_i1 = best_tour[(i + 1) % n]\n+                p_k = best_tour[k]\n+                p_k1 = best_tour[(k + 1) % n]\n+                \n+                # Calculate old edges: (p_i -> p_i1) and (p_k -> p_k1)\n+                old_len_1 = math.hypot(points[p_i][0] - points[p_i1][0], points[p_i][1] - points[p_i1][1])\n+                old_len_2 = math.hypot(points[p_k][0] - points[p_k1][0], points[p_k][1] - points[p_k1][1])\n+                old_total_delta = old_len_1 + old_len_2\n+\n+                # Calculate new edges: (p_i -> p_k) and (p_i1 -> p_k1)\n+                new_len_1 = math.hypot(points[p_i][0] - points[p_k][0], points[p_i][1] - points[p_k][1])\n+                new_len_2 = math.hypot(points[p_i1][0] - points[p_k1][0], points[p_i1][1] - points[p_k1][1])\n+                new_total_delta = new_len_1 + new_len_2\n+                \n+                if new_total_delta < old_total_delta:\n+                    # Perform the swap by reversing the segment best_tour[i+1:k+1]\n+                    new_tour = best_tour[:i+1] + best_tour[i+1:k+1][::-1] + best_tour[k+1:]\n+                    \n+                    # Update tour and length\n+                    best_tour = new_tour\n+                    best_length -= (old_total_delta - new_total_delta)\n+                    improved = True\n+                    # Do not break here; allow inner loop to continue to find more improvements in this pass\n+                \n+    return best_tour\n # OMEGA-BLOCK-END\n",
