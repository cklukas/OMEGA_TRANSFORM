 "best_diff": "--- initial\n+++ best\n@@ -18,16 +18,153 @@\n     makes the program invalid). The tour returns from the last city to the first.\n     Only the Python standard library may be used.\n \n-    Current method: plain nearest-neighbour construction starting at city 0.\n+    Current method: greedy edge insertion followed by 2-opt local search.\n     \"\"\"\n     n = len(points)\n-    unvisited = set(range(1, n))\n-    tour = [0]\n-    x, y = points[0]\n-    while unvisited:\n-        nxt = min(unvisited, key=lambda j: (points[j][0] - x) ** 2 + (points[j][1] - y) ** 2)\n-        unvisited.remove(nxt)\n-        tour.append(nxt)\n-        x, y = points[nxt]\n+    if n < 2:\n+        return list(range(n))\n+    \n+    # Precompute coordinates for faster access\n+    xs = [p[0] for p in points]\n+    ys = [p[1] for p in points]\n+    \n+    # Helper to compute squared distance\n+    def sq_dist(i, j):\n+        return (xs[i] - xs[j])**2 + (ys[i] - ys[j])**2\n+\n+    # 1. Construct initial tour using greedy edge addition (Kruskal-like)\n+    # Generate all edges, sort by length, add if they don't create a cycle or degree > 2\n+    edges = []\n+    for i in range(n):\n+        for j in range(i + 1, n):\n+            edges.append((sq_dist(i, j), i, j))\n+    \n+    edges.sort(key=lambda e: e[0])\n+    \n+    degree = [0] * n\n+    parent = list(range(n)) # Union-Find\n+    \n+    def find(i):\n+        root = i\n+        while parent[root] != root:\n+            root = parent[root]\n+        # Path compression\n+        curr = i\n+        while curr != root:\n+            nxt = parent[curr]\n+            parent[curr] = root\n+            curr = nxt\n+        return root\n+    \n+    def union(i, j):\n+        root_i = find(i)\n+        root_j = find(j)\n+        if root_i != root_j:\n+            parent[root_i] = root_j\n+            return True\n+        return False\n+\n+    adj = [[] for _ in range(n)]\n+    edges_added = 0\n+    \n+    for d, u, v in edges:\n+        if degree[u] >= 2 or degree[v] >= 2:\n+            continue\n+        if find(u) == find(v):\n+            continue # Would create a cycle\n+        degree[u] += 1\n+        degree[v] += 1\n+        adj[u].append(v)\n+        adj[v].append(u)\n+        union(u, v)\n+        edges_added += 1\n+        if edges_added == n - 1:\n+            break\n+            \n+    # Reconstruct tour from the path\n+    tour = []\n+    if n > 1:\n+        # Find start node (degree 1)\n+        start = -1\n+        for i in range(n):\n+            if degree[i] == 1:\n+                start = i\n+                break\n+        if start == -1:\n+            start = 0 # Should not happen if n>1 and we added n-1 edges\n+            \n+        curr = start\n+        tour.append(curr)\n+        visited_count = 1\n+        while visited_count < n:\n+            next_node = -1\n+            for neighbor in adj[curr]:\n+                if neighbor != tour[-2] if len(tour) >= 2 else True:\n+                     # Simple check: if we came from tour[-2], don't go back unless it's the only option (cycle)\n+                     # But since it's a path, we just pick the neighbor that isn't the previous one\n+                     if len(tour) < 2 or neighbor != tour[-2]:\n+                        next_node = neighbor\n+                        break\n+            \n+            if next_node == -1:\n+                # Fallback: pick any unvisited neighbor? Or break\n+                # This implies a cycle or error in construction. \n+                # With n-1 edges and no cycles, it's a single path.\n+                break\n+                \n+            tour.append(next_node)\n+            curr = next_node\n+            visited_count += 1\n+\n+    # If tour is incomplete (shouldn't be with correct greedy), fill in missing\n+    if len(tour) < n:\n+        missing = set(range(n)) - set(tour)\n+        tour.extend(list(missing))\n+\n+    # 2. 2-Opt Local Search\n+    # Use squared distances for speed\n+    # Precompute tour positions for quick lookup if needed, but here we just modify the list\n+    \n+    start_time = time.process_time()\n+    timeout = time_limit * 0.9 # Safety margin\n+    \n+    improved = True\n+    while improved:\n+        improved = False\n+        check_time = time.process_time()\n+        if check_time - start_time > timeout:\n+            break\n+            \n+        # 2-opt loop\n+        for i in range(1, n - 2):\n+            # Check time periodically\n+            if i % 100 == 0:\n+                if time.process_time() - start_time > timeout:\n+                    break\n+                    \n+            # Edge from i-1 to i\n+            p1_prev = tour[i-1]\n+            p1_curr = tour[i]\n+            \n+            # Edge from j to j+1\n+            for j in range(i + 1, n - 1):\n+                p2_curr = tour[j]\n+                p2_next = tour[j+1]\n+                \n+                # Current edges: (i-1, i) and (j, j+1)\n+                # New edges: (i-1, j) and (i, j+1)\n+                dist_old = sq_dist(p1_prev, p1_curr) + sq_dist(p2_curr, p2_next)\n+                dist_new = sq_dist(p1_prev, p2_curr) + sq_dist(p1_curr, p2_next)\n+                \n+                if dist_new < dist_old:\n+                    # Reverse segment [i, j]\n+                    tour[i : j+1] = reversed(tour[i : j+1])\n+                    improved = True\n+                    # After reversal, the edge (i-1, i) is now (i-1, new_i) which was old j\n+                    # We can continue checking from i, but usually better to restart or continue carefully\n+                    # To avoid excessive checks, we can break inner loop and restart outer? \n+                    # Or just continue. Standard 2-opt usually continues.\n+                    # However, to be safe with time, let's just mark improved and continue.\n+                    \n     return tour\n # OMEGA-BLOCK-END\n",
