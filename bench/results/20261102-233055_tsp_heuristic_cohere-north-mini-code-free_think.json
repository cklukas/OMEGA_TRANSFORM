 "best_diff": "--- initial\n+++ best\n@@ -18,16 +18,156 @@\n     makes the program invalid). The tour returns from the last city to the first.\n     Only the Python standard library may be used.\n \n-    Current method: plain nearest-neighbour construction starting at city 0.\n+    Improved method: start with nearest\u2011neighbour tour, then candidate\u2011based 2\u2011opt\n+    local search with double\u2011bridge perturbations.\n     \"\"\"\n+    import heapq\n+    start_time = time.process_time()\n+    # extract coordinates for fast access\n+    xs = [p[0] for p in points]\n+    ys = [p[1] for p in points]\n     n = len(points)\n+\n+    # precompute full distance matrix (Euclidean)\n+    dist = [[0.0] * n for _ in range(n)]\n+    for i in range(n):\n+        xi, yi = xs[i], ys[i]\n+        row_i = dist[i]\n+        for j in range(i + 1, n):\n+            d = math.hypot(xi - xs[j], yi - ys[j])\n+            row_i[j] = d\n+            dist[j][i] = d\n+\n+    # candidate lists: K nearest neighbours for each city (by distance) using grid\n+    K = 24\n+    cell_count = int(math.sqrt(n)) + 1\n+    cell_size = 1.0 / cell_count\n+    R = 2  # neighbor radius in cells\n+    # map cell -> list of city indices\n+    cell_to_indices = {}\n+    for i in range(n):\n+        cx = int(xs[i] / cell_size)\n+        cy = int(ys[i] / cell_size)\n+        cell_to_indices.setdefault((cx, cy), []).append(i)\n+    cand = [[] for _ in range(n)]\n+    for i in range(n):\n+        cx = int(xs[i] / cell_size)\n+        cy = int(ys[i] / cell_size)\n+        candidates = []\n+        for dx in range(-R, R+1):\n+            for dy in range(-R, R+1):\n+                nb = cell_to_indices.get((cx+dx, cy+dy))\n+                if nb:\n+                    for j in nb:\n+                        if j == i:\n+                            continue\n+                        d = (xs[i] - xs[j])**2 + (ys[i] - ys[j])**2\n+                        candidates.append((d, j))\n+        # sort by distance and take K nearest\n+        candidates.sort()\n+        cand[i] = [j for _, j in candidates[:K]]\n+\n+    # nearest\u2011neighbour construction from city 0\n     unvisited = set(range(1, n))\n     tour = [0]\n-    x, y = points[0]\n+    cur = 0\n     while unvisited:\n-        nxt = min(unvisited, key=lambda j: (points[j][0] - x) ** 2 + (points[j][1] - y) ** 2)\n+        nxt = min(unvisited, key=lambda j: dist[cur][j])\n+        tour.append(nxt)\n         unvisited.remove(nxt)\n-        tour.append(nxt)\n-        x, y = points[nxt]\n-    return tour\n+        cur = nxt\n+\n+    # position array: city -> index in tour\n+    pos = [0] * n\n+    for idx, city in enumerate(tour):\n+        pos[city] = idx\n+\n+    # helper to compute tour length\n+    def tour_len(t):\n+        s = 0.0\n+        for i in range(n):\n+            s += dist[t[i]][t[(i + 1) % n]]\n+        return s\n+\n+    current_len = tour_len(tour)\n+    best_tour = tour[:]\n+    best_len = current_len\n+\n+    # local\u2011search parameters\n+    MAX_PERTURBATIONS = 30\n+    pert_cnt = 0\n+    EPS = 1e-12\n+\n+    # main improvement loop\n+    while True:\n+        elapsed = time.process_time() - start_time\n+        if elapsed > time_limit * 0.95:\n+            break\n+\n+        improved = False\n+        # 2\u2011opt pass using candidate lists\n+        for i in range(n):\n+            if elapsed > time_limit * 0.95:\n+                break\n+            a = tour[i]\n+            b = tour[(i + 1) % n]\n+            for j_city in cand[a]:\n+                j = pos[j_city]\n+                if j <= i + 1:\n+                    continue\n+                c = tour[j]\n+                d = tour[(j + 1) % n]\n+                delta = dist[a][c] + dist[b][d] - dist[a][b] - dist[c][d]\n+                if delta < -EPS:\n+                    # perform 2\u2011opt reversal of segment i+1 .. j\n+                    segment = tour[i + 1:j + 1]\n+                    segment.reverse()\n+                    tour[i + 1:j + 1] = segment\n+                    # update positions of moved cities\n+                    for new_idx, city in enumerate(segment):\n+                        pos[city] = i + 1 + new_idx\n+                    current_len += delta\n+                    if current_len < best_len:\n+                        best_len = current_len\n+                        best_tour = tour[:]\n+                    improved = True\n+                    break\n+            if improved:\n+                break\n+\n+        if not improved:\n+            # double\u2011bridge perturbation\n+            # pick four cut points\n+            indices = sorted(random.sample(range(n), 4))\n+            i1, i2, i3, i4 = indices\n+            # ensure non\u2011empty segments\n+            if i2 - i1 < 1:\n+                i2 = i1 + 1\n+            if i3 - i2 < 1:\n+                i3 = i2 + 1\n+            if i4 - i3 < 1:\n+                i4 = i3 + 1\n+            if i4 >= n:\n+                i4 = n - 1\n+                if i3 >= i4:\n+                    i3 = i4 - 1\n+                    if i2 >= i3:\n+                        i2 = i3 - 1\n+                        if i1 >= i2:\n+                            i1 = i2 - 1\n+            # apply double bridge\n+            new_tour = tour[:i1] + tour[i2:i3] + tour[i1:i2] + tour[i3:i4] + tour[i4:]\n+            # rebuild position array\n+            for idx, city in enumerate(new_tour):\n+                pos[city] = idx\n+            tour = new_tour\n+            current_len = tour_len(tour)\n+            if current_len < best_len:\n+                best_len = current_len\n+                best_tour = tour[:]\n+            pert_cnt += 1\n+            if pert_cnt >= MAX_PERTURBATIONS:\n+                break\n+\n+    return best_tour\n # OMEGA-BLOCK-END\n",
