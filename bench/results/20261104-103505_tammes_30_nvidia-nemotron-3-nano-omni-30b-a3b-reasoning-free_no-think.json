 "best_diff": "--- initial\n+++ best\n@@ -6,21 +6,30 @@\n import random\n \n # OMEGA-BLOCK-START\n+import math\n+\n+# Named constants for Fibonacci sphere construction\n+PHI = (math.sqrt(5) + 1) / 2  # Golden ratio\n+STEP = 1.0 / math.sqrt(30)     # Step size for Fibonacci lattice\n+RADIUS = 1.0                   # Unit sphere radius (kept for clarity, not used in calculation)\n+\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n+    \"\"\"Return a list of n points (x, y, z) on the unit sphere using a Fibonacci lattice.\n \n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n+    This deterministic construction starts from a uniform distribution of points\n+    on the sphere, reducing clustering and improving the minimum angle.\n     \"\"\"\n-    rng = random.Random(1)\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    for i in range(n):\n+        # Golden angle in radians\n+        theta = 2 * math.pi * (i / PHI)\n+        # Z-coordinate from Fibonacci lattice\n+        z = 1 - 2 * (i + 0.5) / n\n+        # Radius of the circle at this z\n+        r = math.sqrt(1 - z * z)\n+        x = r * math.cos(theta)\n+        y = r * math.sin(theta)\n+        points.append((x, y, z))\n     return points\n # OMEGA-BLOCK-END\n \n",
