 "best_diff": "--- initial\n+++ best\n@@ -10,6 +10,10 @@\n import time\n \n # OMEGA-BLOCK-START\n+# Tunable constants\n+CELL = 0.08\n+K_CAND = 15\n+\n def solve(points, time_limit):\n     \"\"\"Return a closed tour through all cities as a permutation of range(len(points)).\n \n@@ -18,16 +22,200 @@\n     makes the program invalid). The tour returns from the last city to the first.\n     Only the Python standard library may be used.\n \n-    Current method: plain nearest-neighbour construction starting at city 0.\n+    Current method: grid-based nearest-neighbour construction followed by time-limited\n+    candidate-list 2-opt local search with don't-look bits.\n     \"\"\"\n     n = len(points)\n-    unvisited = set(range(1, n))\n+    if n <= 2:\n+        return list(range(n))\n+\n+    xs = [p[0] for p in points]\n+    ys = [p[1] for p in points]\n+\n+    # ---- grid for fast nearest-neighbour queries ----\n+    cell = CELL\n+    cols = int(1.0 / cell) + 1\n+    grid = [[] for _ in range(cols * cols)]\n+    for i in range(n):\n+        cx = int(xs[i] / cell)\n+        cy = int(ys[i] / cell)\n+        if cx >= cols:\n+            cx = cols - 1\n+        if cy >= cols:\n+            cy = cols - 1\n+        grid[cx * cols + cy].append(i)\n+\n+    def d2(i, j):\n+        dx = xs[i] - xs[j]\n+        dy = ys[i] - ys[j]\n+        return dx * dx + dy * dy\n+\n+    def knn(i, k):\n+        \"\"\"Return up to k nearest cities to i (excluding i), found via expanding grid rings.\"\"\"\n+        cx = int(xs[i] / cell)\n+        cy = int(ys[i] / cell)\n+        if cx >= cols:\n+            cx = cols - 1\n+        if cy >= cols:\n+            cy = cols - 1\n+        best = []\n+        bestd = []\n+        r = 1\n+        while len(best) < k and r <= cols:\n+            x0 = cx - r\n+            if x0 < 0:\n+                x0 = 0\n+            x1 = cx + r\n+            if x1 >= cols:\n+                x1 = cols - 1\n+            y0 = cy - r\n+            if y0 < 0:\n+                y0 = 0\n+            y1 = cy + r\n+            if y1 >= cols:\n+                y1 = cols - 1\n+            for c in range(x0, x1 + 1):\n+                base = c * cols\n+                for rr in range(y0, y1 + 1):\n+                    for j in grid[base + rr]:\n+                        if j == i:\n+                            continue\n+                        dd = d2(i, j)\n+                        pos = 0\n+                        while pos < len(best) and bestd[pos] < dd:\n+                            pos += 1\n+                        if pos < k:\n+                            best.insert(pos, j)\n+                            bestd.insert(pos, dd)\n+                            if len(best) > k:\n+                                best.pop()\n+                                bestd.pop()\n+            r += 1\n+        return best\n+\n+    # ---- candidate lists ----\n+    cand = [knn(i, K_CAND) for i in range(n)]\n+    cand_set = [set(c) for c in cand]\n+\n+    def in_cand(a, b):\n+        return b in cand_set[a]\n+\n+    # ---- greedy nearest-neighbour construction using candidates ----\n+    unvisited = [True] * n\n+    unvisited[0] = False\n     tour = [0]\n-    x, y = points[0]\n-    while unvisited:\n-        nxt = min(unvisited, key=lambda j: (points[j][0] - x) ** 2 + (points[j][1] - y) ** 2)\n-        unvisited.remove(nxt)\n+    cur = 0\n+    remaining = n - 1\n+    while remaining:\n+        nxt = -1\n+        bestd = float('inf')\n+        for j in cand[cur]:\n+            if unvisited[j]:\n+                dd = d2(cur, j)\n+                if dd < bestd:\n+                    bestd = dd\n+                    nxt = j\n+        if nxt < 0:\n+            # fallback: scan all unvisited\n+            for j in range(n):\n+                if unvisited[j]:\n+                    dd = d2(cur, j)\n+                    if dd < bestd:\n+                        bestd = dd\n+                        nxt = j\n+        unvisited[nxt] = False\n         tour.append(nxt)\n-        x, y = points[nxt]\n+        cur = nxt\n+        remaining -= 1\n+\n+    # ---- position array ----\n+    pos = [0] * n\n+    for i in range(n):\n+        pos[tour[i]] = i\n+\n+    def dist(i, j):\n+        dx = xs[i] - xs[j]\n+        dy = ys[i] - ys[j]\n+        return math.hypot(dx, dy)\n+\n+    best_len = 0.0\n+    for i in range(n):\n+        best_len += dist(tour[i], tour[(i + 1) % n])\n+\n+    # ---- candidate-list 2-opt local search with don't-look bits ----\n+    deadline = time.process_time() + time_limit\n+    improved = True\n+    while improved and time.process_time() < deadline:\n+        improved = False\n+        dont_look = [False] * n\n+        for i in range(n):\n+            if time.process_time() > deadline:\n+                break\n+            a = tour[i]\n+            b = tour[(i + 1) % n]\n+            if dont_look[a] and dont_look[b]:\n+                continue\n+            xa, ya = xs[a], ys[a]\n+            xb, yb = xs[b], ys[b]\n+            ab = math.hypot(xa - xb, ya - yb)\n+            best_delta = 0.0\n+            best_j = -1\n+            # candidate edges (c,d) where c is a neighbour of a or b\n+            for c in cand[a]:\n+                j = pos[c]\n+                if j == i or j == (i + 1) % n:\n+                    continue\n+                d = tour[(j + 1) % n]\n+                if d == a or d == b:\n+                    continue\n+                cd = math.hypot(xs[c] - xs[d], ys[c] - ys[d])\n+                ac = math.hypot(xa - xs[c], ya - ys[c])\n+                bd = math.hypot(xb - xs[d], yb - ys[d])\n+                delta = ac + bd - ab - cd\n+                if delta < best_delta:\n+                    best_delta = delta\n+                    best_j = j\n+            for c in cand[b]:\n+                j = pos[c]\n+                if j == i or j == (i + 1) % n:\n+                    continue\n+                d = tour[(j + 1) % n]\n+                if d == a or d == b:\n+                    continue\n+                cd = math.hypot(xs[c] - xs[d], ys[c] - ys[d])\n+                ac = math.hypot(xa - xs[c], ya - ys[c])\n+                bd = math.hypot(xb - xs[d], yb - ys[d])\n+                delta = ac + bd - ab - cd\n+                if delta < best_delta:\n+                    best_delta = delta\n+                    best_j = j\n+            if best_j >= 0:\n+                # reverse segment tour[i+1 .. best_j] (handling wrap)\n+                left = (i + 1) % n\n+                right = best_j\n+                seg = []\n+                idx = left\n+                while True:\n+                    seg.append(idx)\n+                    if idx == right:\n+                        break\n+                    idx = (idx + 1) % n\n+                seg_len = len(seg)\n+                for k in range(seg_len // 2):\n+                    u = tour[seg[k]]\n+                    v = tour[seg[seg_len - 1 - k]]\n+                    tour[seg[k]] = v\n+                    tour[seg[seg_len - 1 - k]] = u\n+                    pos[u] = seg[seg_len - 1 - k]\n+                    pos[v] = seg[k]\n+                best_len += best_delta\n+                improved = True\n+                dont_look[a] = True\n+                dont_look[b] = True\n+                c = tour[best_j]\n+                d = tour[(best_j + 1) % n]\n+                dont_look[c] = True\n+                dont_look[d] = True\n+\n     return tour\n # OMEGA-BLOCK-END\n",
