 "best_diff": "--- initial\n+++ best\n@@ -21,13 +21,142 @@\n     Current method: plain nearest-neighbour construction starting at city 0.\n     \"\"\"\n     n = len(points)\n-    unvisited = set(range(1, n))\n-    tour = [0]\n-    x, y = points[0]\n-    while unvisited:\n-        nxt = min(unvisited, key=lambda j: (points[j][0] - x) ** 2 + (points[j][1] - y) ** 2)\n-        unvisited.remove(nxt)\n-        tour.append(nxt)\n-        x, y = points[nxt]\n+    start_time = time.process_time()\n+    xs = [p[0] for p in points]\n+    ys = [p[1] for p in points]\n+    if n <= 2:\n+        return list(range(n))\n+    dist = [[0.0] * n for _ in range(n)]\n+    for i in range(n):\n+        xi = xs[i]; yi = ys[i]\n+        di = dist[i]\n+        for j in range(i + 1, n):\n+            dx = xs[j] - xi; dy = ys[j] - yi\n+            d2 = dx * dx + dy * dy\n+            di[j] = d2\n+            dist[j][i] = d2\n+    edges = []\n+    for i in range(n - 1):\n+        xi = xs[i]\n+        yi = ys[i]\n+        for j in range(i + 1, n):\n+            dx = xs[j] - xi\n+            dy = ys[j] - yi\n+            edges.append((dx * dx + dy * dy, i, j))\n+    edges.sort()\n+    parent = list(range(n))\n+    deg = [0] * n\n+    def find(a):\n+        while parent[a] != a:\n+            parent[a] = parent[parent[a]]\n+            a = parent[a]\n+        return a\n+    path_edges = []\n+    components = n\n+    for d2, i, j in edges:\n+        if deg[i] < 2 and deg[j] < 2:\n+            ri = find(i)\n+            rj = find(j)\n+            if ri != rj:\n+                parent[rj] = ri\n+                deg[i] += 1\n+                deg[j] += 1\n+                path_edges.append((i, j))\n+                components -= 1\n+                if components == 1:\n+                    break\n+    if components == 1:\n+        adj = [[] for _ in range(n)]\n+        for i, j in path_edges:\n+            adj[i].append(j)\n+            adj[j].append(i)\n+        start = next(k for k in range(n) if deg[k] == 1)\n+        tour = []\n+        prev = -1\n+        cur = start\n+        while True:\n+            tour.append(cur)\n+            nxts = [v for v in adj[cur] if v != prev]\n+            if not nxts:\n+                break\n+            prev, cur = cur, nxts[0]\n+\n+    improved = True\n+    while improved and time.process_time() - start_time < time_limit:\n+        improved = False\n+        for i in range(n - 2):\n+            if time.process_time() - start_time > time_limit:\n+                return tour\n+            a = tour[i]\n+            b = tour[(i + 1) % n]\n+            ax = xs[a]; ay = ys[a]; bx = xs[b]; by = ys[b]\n+            ab2 = dist[a][b]\n+            for k in range(i + 2, n if i > 0 else n - 1):\n+                c = tour[k]\n+                d = tour[(k + 1) % n]\n+                if dist[a][c] + dist[b][d] < ab2 + dist[c][d]:\n+                    tour[i + 1:k + 1] = tour[i + 1:k + 1][::-1]\n+                    improved = True\n+                    break\n+        if improved:\n+            continue\n+        moved = True\n+        while moved and time.process_time() - start_time < time_limit:\n+            moved = False\n+            for seg in (1, 2, 3):\n+                if seg > n - 2:\n+                    break\n+                found = False\n+                for i in range(n - seg + 1):\n+                    if time.process_time() - start_time > time_limit:\n+                        return tour\n+                    segc = tour[i:i + seg]\n+                    p = tour[i - 1]\n+                    s = tour[(i + seg) % n]\n+                    d_ps = dist[p][s]\n+                    d_p0 = dist[p][segc[0]]\n+                    d_0s = dist[segc[-1]][s]\n+                    base_d = d_ps - d_p0 - d_0s\n+                    base_dr = d_ps - dist[p][segc[-1]] - dist[segc[0]][s]\n+                    best_d = float('inf')\n+                    best_u = -1\n+                    best_v = -1\n+                    best_rev = False\n+                    for j in range(n):\n+                        u = tour[j]\n+                        v = tour[(j + 1) % n]\n+                        if u in segc or v in segc:\n+                            continue\n+                        d_uv = dist[u][v]\n+                        f = segc[0]\n+                        l = segc[-1]\n+                        tot = base_d + dist[u][f] + dist[l][v] - d_uv\n+                        if tot < best_d:\n+                            best_d = tot\n+                            best_u = u\n+                            best_v = v\n+                            best_rev = False\n+                        f = segc[-1]\n+                        l = segc[0]\n+                        tot = base_dr + dist[u][f] + dist[l][v] - d_uv\n+                        if tot < best_d:\n+                            best_d = tot\n+                            best_u = u\n+                            best_v = v\n+                            best_rev = True\n+                    if best_u >= 0 and best_d < -1e-9:\n+                        new = tour[:i] + tour[i + seg:]\n+                        idx = new.index(best_u) + 1\n+                        segm = segc[::-1] if best_rev else segc\n+                        new[idx:idx] = segm\n+                        tour[:] = new\n+                        moved = True\n+                        improved = True\n+                        found = True\n+                        break\n+                if found:\n+                    break\n+            if not moved:\n+                break\n     return tour\n # OMEGA-BLOCK-END\n",
