 "best_diff": "--- initial\n+++ best\n@@ -7,20 +7,30 @@\n \n # OMEGA-BLOCK-START\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n-\n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n-    \"\"\"\n-    rng = random.Random(1)\n+    \"\"\"Return a list of n points (x, y, z) on the unit sphere using a Fibonacci-like structure.\"\"\"\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    phi = (1.0 + math.sqrt(5.0)) / 2.0  # Golden ratio\n+    \n+    # Generate points based on latitude bands and angular distribution\n+    for i in range(n):\n+        # Use index i to determine latitude band (z coordinate proxy)\n+        # Map i to a range, scaled appropriately.\n+        # We use a distribution that favors points away from the poles initially,\n+        # or a specific pattern derived from continued fractions/Fibonacci sequences.\n+        \n+        # Use golden ratio to distribute angular components\n+        # i controls the base angle, phi controls the phase/azimuth\n+        theta = 2.0 * math.pi * i / n\n+        phi_angle = 2.0 * math.pi * i * phi / n # Incorporate golden ratio into azimuthal spread\n+        \n+        # Distribute latitude (z) more evenly across the sphere's surface\n+        z = math.cos(theta) * (0.5 + 0.5 * (i % 2)) # Simple alternating latitude bias\n+        \n+        # Normalize to unit sphere (though the evaluator handles normalization)\n+        r = math.sqrt(1.0 - z*z)\n+        x = r * math.cos(phi_angle)\n+        y = r * math.sin(phi_angle)\n+        points.append((x, y, z))\n     return points\n # OMEGA-BLOCK-END\n \n",
