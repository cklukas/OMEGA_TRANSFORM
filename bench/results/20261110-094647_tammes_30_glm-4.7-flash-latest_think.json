 "best_diff": "--- initial\n+++ best\n@@ -11,17 +11,57 @@\n \n     Vectors need not be normalized (the evaluator normalizes them), but none may be\n     zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n+    start uses a Fibonacci lattice and gradient descent repulsion to maximize\n+    the minimum pairwise angle.\n     \"\"\"\n     rng = random.Random(1)\n+\n+    # Fibonacci lattice initialization\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n-    return points\n+    phi = math.pi * (3. - math.sqrt(5.))\n+    for i in range(n):\n+        y = 1 - (i / float(n - 1)) * 2\n+        r = math.sqrt(1 - y * y)\n+        theta = phi * i\n+        x = math.cos(theta) * r\n+        z = math.sin(theta) * r\n+        points.append([x, y, z])\n+    rng.shuffle(points)\n+\n+    # Optimization parameters\n+    REPULSION_POWER = 2.0\n+    STEPS = 400\n+    STEP_DECAY = 0.96\n+    INIT_STEP = 0.05\n+\n+    cur_step = INIT_STEP\n+    for _ in range(STEPS):\n+        forces = [[0.0, 0.0, 0.0] for _ in range(n)]\n+        for i in range(n):\n+            for j in range(i + 1, n):\n+                dx = points[i][0] - points[j][0]\n+                dy = points[i][1] - points[j][1]\n+                dz = points[i][2] - points[j][2]\n+                dist_sq = dx*dx + dy*dy + dz*dz\n+                mag = 1.0 / (dist_sq ** REPULSION_POWER)\n+                forces[i][0] += dx * mag\n+                forces[i][1] += dy * mag\n+                forces[i][2] += dz * mag\n+                forces[j][0] -= dx * mag\n+                forces[j][1] -= dy * mag\n+                forces[j][2] -= dz * mag\n+        for i in range(n):\n+            points[i][0] += forces[i][0] * cur_step\n+            points[i][1] += forces[i][1] * cur_step\n+            points[i][2] += forces[i][2] * cur_step\n+            norm = math.sqrt(points[i][0]**2 + points[i][1]**2 + points[i][2]**2)\n+            if norm > 0:\n+                points[i][0] /= norm\n+                points[i][1] /= norm\n+                points[i][2] /= norm\n+        cur_step *= STEP_DECAY\n+\n+    return [(p[0], p[1], p[2]) for p in points]\n # OMEGA-BLOCK-END\n \n \n",
