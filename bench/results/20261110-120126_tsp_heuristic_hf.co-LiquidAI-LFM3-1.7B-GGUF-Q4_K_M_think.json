 "best_diff": "--- initial\n+++ best\n@@ -10,6 +10,9 @@\n import time\n \n # OMEGA-BLOCK-START\n+GRID_CELL_SIZE = 0.05      # grid cell size heuristic (optional)\n+MAX_2OPT_PASSES = 5        # number of full reversal scans per pass; increase for stronger search\n+\n def solve(points, time_limit):\n     \"\"\"Return a closed tour through all cities as a permutation of range(len(points)).\n \n@@ -18,16 +21,63 @@\n     makes the program invalid). The tour returns from the last city to the first.\n     Only the Python standard library may be used.\n \n-    Current method: plain nearest-neighbour construction starting at city 0.\n+    Uses a greedy nearest\u2011neighbor construction starting at city 0, followed by\n+    full two\u2011opt reversal passes (MAX_2OPT_PASSES) and edge recomputation for each candidate.\n     \"\"\"\n+    if not points:\n+        return []\n     n = len(points)\n+    start = time.process_time()\n+    \n+    # Greedy nearest neighbor from city 0\n     unvisited = set(range(1, n))\n     tour = [0]\n     x, y = points[0]\n     while unvisited:\n-        nxt = min(unvisited, key=lambda j: (points[j][0] - x) ** 2 + (points[j][1] - y) ** 2)\n-        unvisited.remove(nxt)\n-        tour.append(nxt)\n-        x, y = points[nxt]\n+        best_j = None\n+        best_d2 = float('inf')\n+        for j in unvisited:\n+            dx = points[j][0] - x\n+            dy = points[j][1] - y\n+            d2 = dx*dx + dy*dy\n+            if d2 < best_d2:\n+                best_d2 = d2\n+                best_j = j\n+        unvisited.remove(best_j)\n+        tour.append(best_j)\n+        x, y = points[best_j]\n+    \n+    for _ in range(MAX_2OPT_PASSES):\n+        # current total edge length of the current tour\n+        cur_len = 0.0\n+        for a in range(n):\n+            b = (a + 1) % n\n+            dx = points[tour[a]][0] - points[tour[b]][0]\n+            dy = points[tour[a]][1] - points[tour[b]][1]\n+            cur_len += math.hypot(dx, dy)\n+        improved = False\n+        for i in range(n):\n+            for j in range(i + 1, n):\n+                if tour[i] == tour[j]:\n+                    continue\n+                new_tour = tour[:i] + list(reversed(tour[i:j+1])) + tour[j+1:]\n+                total_new = 0.0\n+                for k in range(n):\n+                    a_idx = new_tour[k]\n+                    b_idx = new_tour[(k + 1) % n]\n+                    dx = points[a_idx][0] - points[b_idx][0]\n+                    dy = points[a_idx][1] - points[b_idx][1]\n+                    total_new += math.hypot(dx, dy)\n+                if total_new < cur_len:\n+                    tour = new_tour\n+                    improved = True\n+                    break\n+            if improved:\n+                break\n+        if not improved:\n+            break\n+    \n+    elapsed = time.process_time() - start\n     return tour\n+\n # OMEGA-BLOCK-END\n",
