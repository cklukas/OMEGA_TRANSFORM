 "best_diff": "--- initial\n+++ best\n@@ -18,16 +18,84 @@\n     makes the program invalid). The tour returns from the last city to the first.\n     Only the Python standard library may be used.\n \n-    Current method: plain nearest-neighbour construction starting at city 0.\n+    Current method: Nearest neighbor construction followed by 2-opt local search.\n     \"\"\"\n     n = len(points)\n-    unvisited = set(range(1, n))\n+    X = [p[0] for p in points]\n+    Y = [p[1] for p in points]\n+    \n+    def dist_sq(i, j):\n+        return (X[i] - X[j])**2 + (Y[i] - Y[j])**2\n+\n+    # Helper for Euclidean distance\n+    def dist(i, j):\n+        return math.hypot(X[i] - X[j], Y[i] - Y[j])\n+\n+    # 1. Farthest Insertion Construction\n     tour = [0]\n-    x, y = points[0]\n-    while unvisited:\n-        nxt = min(unvisited, key=lambda j: (points[j][0] - x) ** 2 + (points[j][1] - y) ** 2)\n-        unvisited.remove(nxt)\n-        tour.append(nxt)\n-        x, y = points[nxt]\n-    return tour\n+    unplaced = list(range(1, n))\n+    \n+    while unplaced:\n+        city_k = unplaced.pop(0) # Simple sequential order, could be random/optimized\n+        best_insertion_i = 0\n+        min_delta_L = float('inf')\n+        \n+        for i in range(len(tour)):\n+            # Check insertion between tour[i-1] and tour[i]\n+            # Indices are modulo len(tour) for wrap-around check\n+            \n+            # Edges involved: (tour[i-1], tour[i])\n+            p_prev = tour[(i - 1) % len(tour)]\n+            p_next = tour[i % len(tour)]\n+            \n+            # Calculate delta L for inserting city_k between p_prev and p_next\n+            delta_L = dist(p_prev, city_k) + dist(city_k, p_next) - dist(p_prev, p_next)\n+            \n+            if delta_L < min_delta_L:\n+                min_delta_L = delta_L\n+                best_insertion_i = i\n+        \n+        # Insert city_k at the best spot found\n+        tour.insert(best_insertion_i, city_k)\n+\n+    # 2. 2-Opt Local Search (Best Improvement Strategy)\n+    current_tour = list(tour)\n+    time_start = time.process_time()\n+    \n+    while True:\n+        best_improvement = 0.0\n+        best_i, best_j = -1, -1\n+        \n+        # Search for best improving swap\n+        for i in range(1, n - 1):\n+            if (time.process_time() - time_start) > time_limit * 0.99: break # Time check\n+            for j in range(i + 1, n):\n+                # Indices for edges: (i-1, i) and (j, j+1)\n+                \n+                p_prev = current_tour[i-1]\n+                p_i = current_tour[i]\n+                p_j = current_tour[j]\n+                p_next = current_tour[(j+1) % n]\n+\n+                # Calculate change in actual Euclidean distance\n+                old_dist = dist(p_prev, p_i) + dist(p_j, p_next)\n+                new_dist = dist(p_prev, p_j) + dist(p_i, p_next)\n+                \n+                improvement = old_dist - new_dist\n+                \n+                if improvement > best_improvement:\n+                    best_improvement = improvement\n+                    best_i, best_j = i, j\n+        \n+        if best_improvement > 1e-9:\n+            # Apply the best found swap\n+            current_tour[best_i:best_j+1] = current_tour[best_i:best_j+1][::-1]\n+        else:\n+            break # No improvement found in a full sweep\n+            \n+        # Check time limit after applying the best swap\n+        if (time.process_time() - time_start) > time_limit * 0.9:\n+            return current_tour\n+            \n+    return current_tour\n # OMEGA-BLOCK-END\n",
