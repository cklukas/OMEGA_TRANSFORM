 "best_diff": "--- initial\n+++ best\n@@ -11,23 +11,93 @@\n \n # OMEGA-BLOCK-START\n def solve(points, time_limit):\n-    \"\"\"Return a closed tour through all cities as a permutation of range(len(points)).\n+    \"\"\"Return a closed tour through all cities as a permutation of range(len(points)).\"\"\"\n+    n = len(points)\n+    if n <= 1: return list(range(n))\n+    if n == 2: return [0, 1]\n+    xs, ys = [p[0] for p in points], [p[1] for p in points]\n \n-    points: list of (x, y) float tuples in the unit square; time_limit: CPU seconds\n-    allowed for this call (measured with time.process_time(); more than 1.5 x the limit\n-    makes the program invalid). The tour returns from the last city to the first.\n-    Only the Python standard library may be used.\n+    # Nearest Neighbor construction\n+    tour = [0]\n+    visited = [False] * n\n+    visited[0] = True\n+    curr = 0\n+    for _ in range(n - 1):\n+        best_d2, nxt = 1e18, -1\n+        cx, cy = xs[curr], ys[curr]\n+        for j in range(n):\n+            if not visited[j]:\n+                d2 = (xs[j] - cx)**2 + (ys[j] - cy)**2\n+                if d2 < best_d2:\n+                    best_d2, nxt = d2, j\n+        tour.append(nxt)\n+        visited[nxt] = True\n+        curr = nxt\n \n-    Current method: plain nearest-neighbour construction starting at city 0.\n-    \"\"\"\n-    n = len(points)\n-    unvisited = set(range(1, n))\n-    tour = [0]\n-    x, y = points[0]\n-    while unvisited:\n-        nxt = min(unvisited, key=lambda j: (points[j][0] - x) ** 2 + (points[j][1] - y) ** 2)\n-        unvisited.remove(nxt)\n-        tour.append(nxt)\n-        x, y = points[nxt]\n-    return tour\n+    # Precompute distance matrix\n+    dist = [[0.0] * n for _ in range(n)]\n+    for i in range(n):\n+        xi, yi = xs[i], ys[i]\n+        di = dist[i]\n+        for j in range(i + 1, n):\n+            d = math.hypot(xi - xs[j], yi - ys[j])\n+            di[j] = dist[j][i] = d\n+\n+    # Precompute candidate lists (20 nearest neighbors)\n+    candidate_list = [[] for _ in range(n)]\n+    for i in range(n):\n+        dists = []\n+        di = dist[i]\n+        for j in range(n):\n+            if i != j: dists.append((di[j], j))\n+        dists.sort()\n+        for k in range(min(20, n - 1)):\n+            candidate_list[i].append(dists[k][1])\n+\n+    pos = [0] * n\n+    for i in range(n): pos[tour[i]] = i\n+\n+    def get_tour_len(t):\n+        l = 0\n+        for i in range(n):\n+            l += dist[t[i]][t[(i + 1) % n]]\n+        return l\n+\n+    best_tour = tour[:]\n+    best_len = get_tour_len(tour)\n+    start_time = time.process_time()\n+    limit = time_limit - 0.4\n+\n+    # Iterated Local Search\n+    while time.process_time() - start_time < limit:\n+        # 2-opt local search\n+        improved = True\n+        while improved:\n+            improved = False\n+            for i in range(n):\n+                a, b = tour[i], tour[(i + 1) % n]\n+                for c in candidate_list[a]:\n+                    j = pos[c]\n+                    if i + 1 < j and not (i == 0 and j == n - 1):\n+                        d = tour[(j + 1) % n]\n+                        if dist[a][c] + dist[b][d] < dist[a][b] + dist[c][d]:\n+                            tour[i+1 : j+1] = tour[i+1 : j+1][::-1]\n+                            for k in range(i + 1, j + 1): pos[tour[k]] = k\n+                            improved = True\n+                            break\n+                if improved: break\n+        \n+        cur_len = get_tour_len(tour)\n+        if cur_len < best_len:\n+            best_len, best_tour = cur_len, tour[:]\n+        \n+        # Random 2-opt kick\n+        idx1 = random.randint(0, n - 3)\n+        idx2 = random.randint(idx1 + 2, n - 1)\n+        tour[idx1+1 : idx2+1] = tour[idx1+1 : idx2+1][::-1]\n+        for k in range(idx1 + 1, idx2 + 1): pos[tour[k]] = k\n+        \n+        if time.process_time() - start_time > limit: break\n+\n+    return best_tour\n # OMEGA-BLOCK-END\n",
