 "best_diff": "--- initial\n+++ best\n@@ -20,15 +20,21 @@\n \n \n def max_radii(centers):\n-    \"\"\"Largest radii for fixed centers: limit by walls, then shrink overlapping pairs.\"\"\"\n-    radii = [min(x, y, 1 - x, 1 - y) for x, y in centers]\n-    for a in range(len(centers)):\n-        for b in range(a + 1, len(centers)):\n-            d = math.dist(centers[a], centers[b])\n-            if radii[a] + radii[b] > d:\n-                s = d / (radii[a] + radii[b])\n-                radii[a] *= s\n-                radii[b] *= s\n+    \"\"\"Largest radii for fixed centers: limit by walls, then iteratively adjust for overlaps.\"\"\"\n+    w = [min(x, y, 1 - x, 1 - y) for x, y in centers]\n+    radii = list(w)\n+    for _ in range(100):\n+        for i in range(len(centers)):\n+            min_r = w[i]\n+            for j in range(len(centers)):\n+                if i == j:\n+                    continue\n+                d = math.dist(centers[i], centers[j])\n+                if radii[j] > 0:\n+                    min_r = min(min_r, d - radii[j])\n+                else:\n+                    min_r = min(min_r, d)\n+            radii[i] = max(0.0, min_r)\n     return radii\n # OMEGA-BLOCK-END\n \n",
