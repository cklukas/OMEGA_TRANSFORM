 "best_diff": "--- initial\n+++ best\n@@ -6,21 +6,22 @@\n import random\n \n # OMEGA-BLOCK-START\n+import math\n+\n+GOLDEN_RATIO = (1 + math.sqrt(5)) / 2\n+\n def construct(n=30):\n-    \"\"\"Return a list of n points (x, y, z) on the unit sphere.\n-\n-    Vectors need not be normalized (the evaluator normalizes them), but none may be\n-    zero. The score is the minimum angle in degrees between any two points. This\n-    start draws uniformly random points with a fixed seed, so some pairs end up\n-    close together.\n+    \"\"\"Return a list of n points (x, y, z) on the unit sphere using a deterministic\n+    golden-spiral layout.\n     \"\"\"\n-    rng = random.Random(1)\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    for k in range(n):\n+        angle = k * GOLDEN_RATIO\n+        radius = math.sqrt(1.0 - (math.cos(angle))**2)\n+        x = math.cos(angle)\n+        y = math.sin(angle)\n+        z = math.sqrt(1.0 - (math.sin(angle))**2)\n+        points.append((x, y, z))\n     return points\n # OMEGA-BLOCK-END\n \n",
