 "best_diff": "--- initial\n+++ best\n@@ -14,13 +14,61 @@\n     start draws uniformly random points with a fixed seed, so some pairs end up\n     close together.\n     \"\"\"\n-    rng = random.Random(1)\n+    import math\n+    golden_angle = math.pi * (3 - math.sqrt(5))\n     points = []\n-    for _ in range(n):\n-        z = rng.uniform(-1.0, 1.0)\n-        phi = rng.uniform(0.0, 2 * math.pi)\n-        s = math.sqrt(1.0 - z * z)\n-        points.append((s * math.cos(phi), s * math.sin(phi), z))\n+    for i in range(n):\n+        z = 1 - (2 * i + 1) / n\n+        r = math.sqrt(1 - z * z)\n+        phi = i * golden_angle\n+        x = r * math.cos(phi)\n+        y = r * math.sin(phi)\n+        points.append([x, y, z])\n+\n+    step = 0.01\n+    for _ in range(10):\n+        # find nearest neighbour for each point\n+        nn = [None] * n\n+        for i in range(n):\n+            best = float('inf')\n+            best_idx = -1\n+            xi, yi, zi = points[i]\n+            for j in range(n):\n+                if i == j:\n+                    continue\n+                xj, yj, zj = points[j]\n+                dx = xi - xj\n+                dy = yi - yj\n+                dz = zi - zj\n+                d2 = dx * dx + dy * dy + dz * dz\n+                if d2 < best:\n+                    best = d2\n+                    best_idx = j\n+            nn[i] = best_idx\n+\n+        # move each point away from its nearest neighbour\n+        for i in range(n):\n+            j = nn[i]\n+            xi, yi, zi = points[i]\n+            xj, yj, zj = points[j]\n+            dx = xi - xj\n+            dy = yi - yj\n+            dz = zi - zj\n+            d = math.sqrt(dx * dx + dy * dy + dz * dz)\n+            if d > 0:\n+                factor = step / d\n+                xi_new = xi + dx * factor\n+                yi_new = yi + dy * factor\n+                zi_new = zi + dz * factor\n+                points[i] = [xi_new, yi_new, zi_new]\n+\n+        # renormalise\n+        for i in range(n):\n+            x, y, z = points[i]\n+            norm = math.sqrt(x * x + y * y + z * z)\n+            points[i] = [x / norm, y / norm, z / norm]\n+\n+    return [tuple(p) for p in points]\n     return points\n # OMEGA-BLOCK-END\n \n",
